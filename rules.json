{
  "selfHosted": true,
  "bootstrap": {
    "entry": "src/cli/cli.lz",
    "compiler": "dist/cli/cli.js",
    "stage": 2
  },
  "build": {
    "targets": ["bytecode", "c", "wat"],
    "output": "bin/luazi",
    "optimize": true,
    "selfCompile": true
  },
  "language": {
    "ownership": true,
