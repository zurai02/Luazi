// Luazi Type Checker
// Hindley-Milner type inference with gradual typing

import * as AST from "./ast"
import * as Types from "./types"

pub type TypeError = {
  message: string,
  span: AST.Span,
}

pub type TypeVariable = {
  kind: string,
  id: number,
  instance: Types.Type | nil,
}

pub type Scheme = {
  vars: [TypeVariable],
  type: Types.Type,
}

pub struct TypeEnv {
  map: {string: Scheme},
  parent: TypeEnv | nil,
}

impl TypeEnv {
  pub fn new(parent: TypeEnv | nil) -> Self {
    return Self { map: {}, parent: parent }
  }

  pub fn get(self, name: string) -> Scheme | nil {
    let result = self.map[name]
    if result != nil {
      return result
    }
    if self.parent != nil {
      return self.parent.get(name)
    }
    return nil
  }

  pub fn set(self, name: string, scheme: Scheme) {
    self.map[name] = scheme
  }

  pub fn child(self) -> TypeEnv {
    return TypeEnv.new(self)
  }
}

pub struct TypeChecker {
  env: TypeEnv,
  errors: [TypeError],
  varCounter: number,
  strictMode: bool,
}

impl TypeChecker {
  pub fn new(strict: bool) -> Self {
    let checker = Self {
      env: TypeEnv.new(nil),
      errors: [],
      varCounter: 0,
      strictMode: strict,
    }
    checker.initBuiltins()
    return checker
  }

  fn initBuiltins(self) {
    self.env.set("print", { vars: [], type: Types.tFunction([{ name: "args", type: Types.tAny, isOptional: false, isRest: true }], Types.tNil) })
    self.env.set("println", { vars: [], type: Types.tFunction([{ name: "args", type: Types.tAny, isOptional: false, isRest: true }], Types.tNil) })
    self.env.set("type_of", { vars: [], type: Types.tFunction([{ name: "value", type: Types.tAny, isOptional: false, isRest: false }], Types.tString) })
    self.env.set("assert", { vars: [], type: Types.tFunction([
      { name: "condition", type: Types.tBool, isOptional: false, isRest: false },
      { name: "message", type: Types.tString, isOptional: true, isRest: false }
    ], Types.tNil) })
    self.env.set("panic", { vars: [], type: Types.tFunction([{ name: "message", type: Types.tString, isOptional: true, isRest: false }], { kind: Types.TypeKind.Never }) })
    self.env.set("len", { vars: [self.freshVar()], type: Types.tFunction([{ name: "collection", type: Types.tAny, isOptional: false, isRest: false }], Types.tNumber) })
    self.env.set("clone", { vars: [self.freshVar()], type: Types.tFunction([{ name: "value", type: Types.tAny, isOptional: false, isRest: false }], Types.tAny) })
    self.env.set("math", { vars: [], type: Types.tNamed("math") })
  }

  pub fn check(self, program: AST.Program) -> [TypeError] {
    for stmt in program.body {
      self.inferStatement(stmt)
    }
    return self.errors
  }

  fn inferStatement(self, stmt: AST.Statement) {
    match stmt.kind {
      "VarDecl" => self.inferVarDecl(stmt)
      "FnDecl" => self.inferFnDecl(stmt)
      "If" => self.inferIf(stmt)
      "While" => self.inferWhile(stmt)
      "For" => self.inferFor(stmt)
      "ForIn" => self.inferForIn(stmt)
      "Match" => self.inferMatch(stmt)
      "Return" => self.inferReturn(stmt)
      "Break" => {}
      "Continue" => {}
      "ExprStmt" => self.inferExpression(stmt.expression)
      "Block" => self.inferBlock(stmt)
      "StructDecl" => self.inferStructDecl(stmt)
      "EnumDecl" => self.inferEnumDecl(stmt)
      "TraitDecl" => self.inferTraitDecl(stmt)
      "ImplDecl" => self.inferImplDecl(stmt)
      "Import" => {}
      "Export" => self.inferStatement(stmt.declaration)
      "Defer" => self.inferExpression(stmt.expression)
      "Guard" => self.inferGuard(stmt)
      "TypeAlias" => {}
    }
  }

  fn inferVarDecl(self, decl: AST.VarDecl) {
    let initType: Types.Type
    if decl.initializer != nil {
      initType = self.inferExpression(decl.initializer)
    } else {
      initType = Types.tNil
    }

    if decl.typeAnnotation != nil {
      let annotatedType = self.typeFromExpr(decl.typeAnnotation)
      if !self.unify(initType, annotatedType) {
        self.error("Type mismatch: expected " + Types.typeToString(annotatedType) + ", got " + Types.typeToString(initType), decl.span)
      }
      initType = annotatedType
    }

    self.env.set(decl.name, { vars: self.freeVars(initType), type: initType })
  }

  fn inferFnDecl(self, decl: AST.FnDecl) {
    let paramTypes: [Types.FunctionParam] = []
    for p in decl.params {
      let pType = Types.tAny
      if p.type != nil {
        pType = self.typeFromExpr(p.type)
      }
      paramTypes.push({ name: p.name, type: pType, isOptional: p.defaultValue != nil, isRest: false })
    }

    let returnType = Types.tAny
    if decl.returnType != nil {
      returnType = self.typeFromExpr(decl.returnType)
    }

    let fnType = Types.tFunction(paramTypes, returnType, decl.isAsync)
    self.env.set(decl.name, { vars: [], type: fnType })

    let bodyEnv = self.env.child()
    for param in decl.params {
      let pType = Types.tAny
      if param.type != nil {
        pType = self.typeFromExpr(param.type)
      }
      bodyEnv.set(param.name, { vars: [], type: pType })
    }

    let oldEnv = self.env
    self.env = bodyEnv
    self.inferBlock(decl.body)
    self.env = oldEnv
  }

  fn inferIf(self, stmt: AST.IfStmt) {
    let condType = self.inferExpression(stmt.condition)
    if !self.isBoolLike(condType) && self.strictMode {
      self.error("Condition must be boolean, got " + Types.typeToString(condType), stmt.condition.span)
    }
    self.inferBlock(stmt.thenBranch)
    if stmt.elseBranch != nil {
      if stmt.elseBranch.kind == "If" {
        self.inferIf(stmt.elseBranch)
      } else {
        self.inferBlock(stmt.elseBranch)
      }
    }
  }

  fn inferWhile(self, stmt: AST.WhileStmt) {
    let condType = self.inferExpression(stmt.condition)
    if !self.isBoolLike(condType) && self.strictMode {
      self.error("Condition must be boolean, got " + Types.typeToString(condType), stmt.condition.span)
    }
    self.inferBlock(stmt.body)
  }

  fn inferFor(self, stmt: AST.ForStmt) {
    let oldEnv = self.env
    self.env = self.env.child()

    if stmt.init != nil {
      if stmt.init.kind == "VarDecl" {
        self.inferVarDecl(stmt.init)
      } else if stmt.init.kind == "ExprStmt" {
        self.inferExpression(stmt.init.expression)
      }
    }

    if stmt.condition != nil {
      let condType = self.inferExpression(stmt.condition)
      if !self.isBoolLike(condType) && self.strictMode {
        self.error("For condition must be boolean", stmt.condition.span)
      }
    }

    if stmt.increment != nil {
      self.inferExpression(stmt.increment)
    }

    self.inferBlock(stmt.body)
    self.env = oldEnv
  }

  fn inferForIn(self, stmt: AST.ForInStmt) {
    let iterType = self.inferExpression(stmt.iterable)
    let elemType = self.getElementType(iterType)

    let oldEnv = self.env
    self.env = self.env.child()
    self.env.set(stmt.varName, { vars: [], type: elemType })
    self.inferBlock(stmt.body)
    self.env = oldEnv
  }

  fn inferMatch(self, stmt: AST.MatchStmt) {
    let exprType = self.inferExpression(stmt.expression)
    for arm in stmt.arms {
      let patternType = self.inferPattern(arm.pattern)
      if !self.unify(patternType, exprType) {
        self.error("Pattern type " + Types.typeToString(patternType) + " does not match " + Types.typeToString(exprType), arm.pattern.span)
      }
      if arm.guard != nil {
        let guardType = self.inferExpression(arm.guard)
        if !self.isBoolLike(guardType) && self.strictMode {
          self.error("Guard must be boolean", arm.guard.span)
        }
      }
      if arm.body.kind == "Block" {
        self.inferBlock(arm.body)
      } else {
        self.inferExpression(arm.body)
      }
    }
  }

  fn inferReturn(self, stmt: AST.ReturnStmt) -> Types.Type {
    if stmt.value != nil {
      return self.inferExpression(stmt.value)
    }
    return Types.tNil
  }

  fn inferBlock(self, block: AST.Block) {
    let oldEnv = self.env
    self.env = self.env.child()
    for stmt in block.statements {
      self.inferStatement(stmt)
    }
    self.env = oldEnv
  }

  fn inferStructDecl(self, decl: AST.StructDecl) {
    let fieldTypes: {string: Types.Type} = {}
    for field in decl.fields {
      let ftype = Types.tAny
      if field.type != nil {
        ftype = self.typeFromExpr(field.type)
      }
      fieldTypes[field.name] = ftype
    }
    let structType: Types.StructType = {
      kind: Types.TypeKind.Struct,
      name: decl.name,
      fields: fieldTypes,
      methods: {},
    }
    self.env.set(decl.name, { vars: [], type: structType })
  }

  fn inferEnumDecl(self, decl: AST.EnumDecl) {
    let variants: [Types.EnumVariant] = []
    for v in decl.variants {
      let fields: [Types.Type] = []
      for f in v.fields {
        let ftype = Types.tAny
        if f.type != nil {
          ftype = self.typeFromExpr(f.type)
        }
        fields.push(ftype)
      }
      variants.push({ name: v.name, fields: fields })
    }
    let enumType: Types.EnumType = {
      kind: Types.TypeKind.Enum,
      name: decl.name,
      variants: variants,
    }
    self.env.set(decl.name, { vars: [], type: enumType })
  }

  fn inferTraitDecl(self, decl: AST.TraitDecl) {
    let methods: {string: Types.FunctionType} = {}
    for method in decl.methods {
      let params: [Types.FunctionParam] = []
      for p in method.params {
        let pType = Types.tAny
        if p.type != nil {
          pType = self.typeFromExpr(p.type)
        }
        params.push({ name: p.name, type: pType, isOptional: p.defaultValue != nil, isRest: false })
      }
      let ret = Types.tAny
      if method.returnType != nil {
        ret = self.typeFromExpr(method.returnType)
      }
      methods[method.name] = Types.tFunction(params, ret) as Types.FunctionType
    }
    let traitType: Types.TraitType = {
      kind: Types.TypeKind.Trait,
      name: decl.name,
      methods: methods,
    }
    self.env.set(decl.name, { vars: [], type: traitType })
  }

  fn inferImplDecl(self, decl: AST.ImplDecl) {
    let targetType = self.typeFromExpr(decl.target)
    if decl.trait != nil {
      let traitType = self.typeFromExpr(decl.trait)
    }
    for method in decl.methods {
      self.inferFnDecl(method)
    }
  }

  fn inferGuard(self, stmt: AST.GuardStmt) {
    let condType = self.inferExpression(stmt.condition)
    if !self.isBoolLike(condType) && self.strictMode {
      self.error("Guard condition must be boolean", stmt.condition.span)
    }
    self.inferBlock(stmt.elseBranch)
  }

  fn inferExpression(self, expr: AST.Expression) -> Types.Type {
    match expr.kind {
      "Literal" => self.inferLiteral(expr)
      "Identifier" => self.inferIdentifier(expr)
      "Binary" => self.inferBinary(expr)
      "Unary" => self.inferUnary(expr)
      "Ternary" => self.inferTernary(expr)
      "Call" => self.inferCall(expr)
      "Member" => self.inferMember(expr)
      "Index" => self.inferIndex(expr)
      "Assignment" => self.inferAssignment(expr)
      "Lambda" => self.inferLambda(expr)
      "Array" => self.inferArray(expr)
      "Table" => self.inferTable(expr)
      "Tuple" => self.inferTuple(expr)
      "Range" => Types.tArray(Types.tNumber)
      "Spread" => self.inferExpression(expr.expression)
      "Await" => self.inferAwait(expr)
      "Yield" => self.inferExpression(expr.expression ?? { kind: "Literal", value: nil, raw: "nil", span: expr.span })
      "Try" => self.inferTry(expr)
      "TypeCast" => self.typeFromExpr(expr.targetType)
      "TypeCheck" => Types.tBool
      "BlockExpr" => Types.tAny
      _ => Types.tAny
    }
  }

  fn inferLiteral(self, expr: AST.Literal) -> Types.Type {
    if expr.value == nil {
      return Types.tNil
    }
    if expr.value as bool != nil {
      return Types.tBool
    }
    if expr.value as number != nil {
      return Types.tNumber
    }
    if expr.value as string != nil {
      return Types.tString
    }
    return Types.tAny
  }

  fn inferIdentifier(self, expr: AST.Identifier) -> Types.Type {
    let scheme = self.env.get(expr.name)
    if scheme != nil {
      return self.instantiate(scheme)
    }
    if self.strictMode {
      self.error("Undefined variable: " + expr.name, expr.span)
    }
    return Types.tAny
  }

  fn inferBinary(self, expr: AST.BinaryExpr) -> Types.Type {
    let leftType = self.inferExpression(expr.left)
    let rightType = self.inferExpression(expr.right)

    match expr.operator {
      "+" | "-" | "*" | "/" | "%" | "^" => {
        if self.isNumber(leftType) && self.isNumber(rightType) {
          return Types.tNumber
        }
        if expr.operator == "+" && (self.isString(leftType) || self.isString(rightType)) {
          return Types.tString
        }
        if self.strictMode {
          self.error("Operator '" + expr.operator + "' requires numbers, got " + Types.typeToString(leftType) + " and " + Types.typeToString(rightType), expr.span)
        }
        return Types.tNumber
      }
      "==" | "!=" | "<" | "<=" | ">" | ">=" => {
        return Types.tBool
      }
      "&&" | "||" => {
        return Types.tBool
      }
      "&" | "|" => {
        if self.isNumber(leftType) && self.isNumber(rightType) {
          return Types.tNumber
        }
        return Types.tNumber
      }
      ".." => {
        return Types.tString
      }
      "??" => {
        if self.unify(leftType, rightType) {
          return leftType
        }
        return Types.tUnion(leftType, rightType)
      }
      _ => return Types.tAny
    }
  }

  fn inferUnary(self, expr: AST.UnaryExpr) -> Types.Type {
    let operandType = self.inferExpression(expr.operand)
    match expr.operator {
      "-" => {
        if self.isNumber(operandType) {
          return Types.tNumber
        }
        if self.strictMode {
          self.error("Unary '-' requires number, got " + Types.typeToString(operandType), expr.span)
        }
        return Types.tNumber
      }
      "!" | "not" => return Types.tBool
      "~" => return Types.tNumber
      "#" => return Types.tNumber
      "ref" => return { kind: Types.TypeKind.Ref, inner: operandType }
      "mut" => return { kind: Types.TypeKind.Mut, inner: operandType }
      _ => return operandType
    }
  }

  fn inferTernary(self, expr: AST.TernaryExpr) -> Types.Type {
    let condType = self.inferExpression(expr.condition)
    if !self.isBoolLike(condType) && self.strictMode {
      self.error("Ternary condition must be boolean", expr.condition.span)
    }
    let thenType = self.inferExpression(expr.thenExpr)
    let elseType = self.inferExpression(expr.elseExpr)
    if self.unify(thenType, elseType) {
      return thenType
    }
    return Types.tUnion(thenType, elseType)
  }

  fn inferCall(self, expr: AST.CallExpr) -> Types.Type {
    let calleeType = self.inferExpression(expr.callee)
    if calleeType.kind == Types.TypeKind.Function {
      let fn = calleeType as Types.FunctionType
      let requiredParams = 0
      for p in fn.params {
        if !p.isOptional && !p.isRest {
          requiredParams = requiredParams + 1
        }
      }
      if expr.args.length < requiredParams {
        self.error("Too few arguments: expected " + fn.params.length + ", got " + expr.args.length, expr.span)
      }
      for i in 0..expr.args.length {
        if i < fn.params.length {
          let argType = self.inferExpression(expr.args[i].value)
          if !self.unify(argType, fn.params[i].type) && self.strictMode {
            self.error("Argument " + (i + 1) + " type mismatch: expected " + Types.typeToString(fn.params[i].type) + ", got " + Types.typeToString(argType), expr.args[i].span)
          }
        }
      }
      return fn.returnType
    }
    if calleeType.kind == Types.TypeKind.Any {
      return Types.tAny
    }
    if self.strictMode {
      self.error("Cannot call non-function type: " + Types.typeToString(calleeType), expr.span)
    }
    return Types.tAny
  }

  fn inferMember(self, expr: AST.MemberExpr) -> Types.Type {
    let objType = self.inferExpression(expr.object)
    if objType.kind == Types.TypeKind.Struct {
      let struct = objType as Types.StructType
      let fieldType = struct.fields[expr.property]
      if fieldType != nil {
        return fieldType
      }
      let methodType = struct.methods[expr.property]
      if methodType != nil {
        return methodType
      }
    }
    if objType.kind == Types.TypeKind.Table {
      let tbl = objType as Types.TableType
      return tbl.valueType
    }
    if objType.kind == Types.TypeKind.String && expr.property == "length" {
      return Types.tNumber
    }
    if objType.kind == Types.TypeKind.Any {
      return Types.tAny
    }
    if self.strictMode {
      self.error("Property '" + expr.property + "' does not exist on " + Types.typeToString(objType), expr.span)
    }
    return Types.tAny
  }

  fn inferIndex(self, expr: AST.IndexExpr) -> Types.Type {
    let objType = self.inferExpression(expr.object)
    let idxType = self.inferExpression(expr.index)
    if objType.kind == Types.TypeKind.Array {
      let arr = objType as Types.ArrayType
      return arr.elementType
    }
    if objType.kind == Types.TypeKind.Table {
      let tbl = objType as Types.TableType
      return tbl.valueType
    }
    if objType.kind == Types.TypeKind.String {
      return Types.tString
    }
    if objType.kind == Types.TypeKind.Any {
      return Types.tAny
    }
    if self.strictMode {
      self.error("Cannot index " + Types.typeToString(objType), expr.span)
    }
    return Types.tAny
  }

  fn inferAssignment(self, expr: AST.AssignmentExpr) -> Types.Type {
    let valueType = self.inferExpression(expr.value)
    if expr.target.kind == "Identifier" {
      let name = (expr.target as AST.Identifier).name
      let existing = self.env.get(name)
      if existing != nil {
        let existingType = self.instantiate(existing)
        if !self.unify(valueType, existingType) && self.strictMode {
          self.error("Cannot assign " + Types.typeToString(valueType) + " to " + Types.typeToString(existingType), expr.span)
        }
        return existingType
      }
      self.env.set(name, { vars: [], type: valueType })
      return valueType
    }
    return valueType
  }

  fn inferLambda(self, expr: AST.LambdaExpr) -> Types.Type {
    let paramTypes: [Types.FunctionParam] = []
    for p in expr.params {
      let pType = Types.tAny
      if p.type != nil {
        pType = self.typeFromExpr(p.type)
      }
      paramTypes.push({ name: p.name, type: pType, isOptional: p.defaultValue != nil, isRest: false })
    }

    let oldEnv = self.env
    self.env = self.env.child()
    for param in expr.params {
      let pType = Types.tAny
      if param.type != nil {
        pType = self.typeFromExpr(param.type)
      }
      self.env.set(param.name, { vars: [], type: pType })
    }

    let returnType: Types.Type
    if expr.body.kind == "Block" {
      self.inferBlock(expr.body as AST.Block)
      returnType = Types.tNil
    } else {
      returnType = self.inferExpression(expr.body as AST.Expression)
    }

    self.env = oldEnv
    return Types.tFunction(paramTypes, returnType, expr.isAsync)
  }

  fn inferArray(self, expr: AST.ArrayExpr) -> Types.Type {
    if expr.elements.length == 0 {
      return Types.tArray(Types.tAny)
    }
    let elemTypes: [Types.Type] = []
    for e in expr.elements {
      elemTypes.push(self.inferExpression(e))
    }
    let unified = elemTypes[0]
    for i in 1..elemTypes.length {
      if !self.unify(unified, elemTypes[i]) {
        unified = Types.tUnion(unified, elemTypes[i])
      }
    }
    return Types.tArray(unified)
  }

  fn inferTable(self, expr: AST.TableExpr) -> Types.Type {
    if expr.entries.length == 0 {
      return Types.tTable(Types.tAny, Types.tAny)
    }
    let keyTypes: [Types.Type] = []
    let valueTypes: [Types.Type] = []
    for e in expr.entries {
      if e.key as string != nil {
        keyTypes.push(Types.tString)
      } else {
        keyTypes.push(self.inferExpression(e.key as AST.Expression))
      }
      valueTypes.push(self.inferExpression(e.value))
    }
    let unifiedKey = keyTypes[0]
    for i in 1..keyTypes.length {
      if !self.unify(unifiedKey, keyTypes[i]) {
        unifiedKey = Types.tUnion(unifiedKey, keyTypes[i])
      }
    }
    let unifiedValue = valueTypes[0]
    for i in 1..valueTypes.length {
      if !self.unify(unifiedValue, valueTypes[i]) {
        unifiedValue = Types.tUnion(unifiedValue, valueTypes[i])
      }
    }
    return Types.tTable(unifiedKey, unifiedValue)
  }

  fn inferTuple(self, expr: AST.TupleExpr) -> Types.Type {
    let types: [Types.Type] = []
    for e in expr.elements {
      types.push(self.inferExpression(e))
    }
    return { kind: Types.TypeKind.Tuple, elements: types }
  }

  fn inferAwait(self, expr: AST.AwaitExpr) -> Types.Type {
    let innerType = self.inferExpression(expr.expression)
    if innerType.kind == Types.TypeKind.Generic {
      let gen = innerType as Types.GenericType
      if gen.args.length > 0 {
        return gen.args[0]
      }
    }
    return innerType
  }

  fn inferTry(self, expr: AST.TryExpr) -> Types.Type {
    let tryType = self.inferExpression(expr.expression)
    if expr.catchBody != nil {
      let oldEnv = self.env
      self.env = self.env.child()
      if expr.catchVar != nil {
        self.env.set(expr.catchVar, { vars: [], type: Types.tString })
      }
      self.inferBlock(expr.catchBody)
      self.env = oldEnv
    }
    return tryType
  }

  fn inferPattern(self, pattern: AST.Pattern) -> Types.Type {
    match pattern.kind {
      "LiteralPattern" => self.inferLiteral(pattern.value as AST.Literal)
      "VariablePattern" => self.freshVar()
      "WildcardPattern" => Types.tAny
      "ArrayPattern" => Types.tArray(self.freshVar())
      "StructPattern" => Types.tNamed(pattern.name)
      "EnumPattern" => Types.tNamed(pattern.enumName)
      "RestPattern" => Types.tArray(self.freshVar())
      _ => Types.tAny
    }
  }

  fn typeFromExpr(self, expr: AST.TypeExpr) -> Types.Type {
    match expr.kind {
      "NamedType" => return Types.tNamed((expr as AST.NamedType).name)
      "GenericType" => {
        let gen = expr as AST.GenericType
        let args: [Types.Type] = []
        for a in gen.args {
          args.push(self.typeFromExpr(a))
        }
        return Types.tGeneric(gen.name, args)
      }
      "FunctionType" => {
        let fn = expr as AST.FunctionType
        let params: [Types.FunctionParam] = []
        for i in 0..fn.params.length {
          params.push({ name: "arg" + i, type: self.typeFromExpr(fn.params[i]), isOptional: false, isRest: false })
        }
        return Types.tFunction(params, self.typeFromExpr(fn.returnType))
      }
      "ArrayType" => return Types.tArray(self.typeFromExpr((expr as AST.ArrayType).element))
      "TableType" => {
        let tbl = expr as AST.TableType
        return Types.tTable(self.typeFromExpr(tbl.key), self.typeFromExpr(tbl.value))
      }
      "OptionalType" => return Types.tOptional(self.typeFromExpr((expr as AST.OptionalType).inner))
      "UnionType" => {
        let un = expr as AST.UnionType
        let result = self.typeFromExpr(un.types[0])
        for i in 1..un.types.length {
          result = Types.tUnion(result, self.typeFromExpr(un.types[i]))
        }
        return result
      }
      "IntersectionType" => return Types.tAny
      "RefType" => return { kind: Types.TypeKind.Ref, inner: self.typeFromExpr((expr as AST.RefType).inner) }
      "MutType" => return { kind: Types.TypeKind.Mut, inner: self.typeFromExpr((expr as AST.MutType).inner) }
      "SelfType" => return { kind: Types.TypeKind.Self }
      "WildcardType" => return self.freshVar()
      "LiteralType" => return self.inferLiteral((expr as AST.LiteralType).value)
      _ => return Types.tAny
    }
  }

  fn unify(self, a: Types.Type, b: Types.Type) -> bool {
    if a.kind == Types.TypeKind.Any || b.kind == Types.TypeKind.Any {
      return true
    }
    if a.kind == Types.TypeKind.Unknown || b.kind == Types.TypeKind.Unknown {
      return true
    }
    if a.kind == Types.TypeKind.Nil && b.kind == Types.TypeKind.Nil {
      return true
    }
    if a.kind == Types.TypeKind.Bool && b.kind == Types.TypeKind.Bool {
      return true
    }
    if a.kind == Types.TypeKind.Number && b.kind == Types.TypeKind.Number {
      return true
    }
    if a.kind == Types.TypeKind.String && b.kind == Types.TypeKind.String {
      return true
    }
    if a.kind == b.kind {
      return true
    }
    return false
  }

  fn isBoolLike(self, type: Types.Type) -> bool {
    return type.kind == Types.TypeKind.Bool || type.kind == Types.TypeKind.Any
  }

  fn isNumber(self, type: Types.Type) -> bool {
    return type.kind == Types.TypeKind.Number || type.kind == Types.TypeKind.Any
  }

  fn isString(self, type: Types.Type) -> bool {
    return type.kind == Types.TypeKind.String || type.kind == Types.TypeKind.Any
  }

  fn getElementType(self, type: Types.Type) -> Types.Type {
    if type.kind == Types.TypeKind.Array {
      return (type as Types.ArrayType).elementType
    }
    if type.kind == Types.TypeKind.String {
      return Types.tString
    }
    if type.kind == Types.TypeKind.Table {
      return (type as Types.TableType).valueType
    }
    return Types.tAny
  }

  fn freshVar(self) -> Types.Type {
    self.varCounter = self.varCounter + 1
    return { kind: Types.TypeKind.Unknown, id: self.varCounter }
  }

  fn freeVars(self, type: Types.Type) -> [TypeVariable] {
    return []
  }

  fn instantiate(self, scheme: Scheme) -> Types.Type {
    return scheme.type
  }

  fn error(self, message: string, span: AST.Span) {
    self.errors.push({ message: message, span: span })
  }
}

pub fn typeCheck(program: AST.Program, strict: bool) -> [TypeError] {
  return TypeChecker.new(strict).check(program)
}
