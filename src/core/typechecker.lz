// typechecker.lz - Luazi Type System & Inference
import core
import ast

struct TypeError { msg: string; span: Span }
fn TypeError.new(msg: string, span: Span) -> TypeError { return TypeError { msg: msg, span: span } }

enum Type {
  Int { bits: int; signed: bool }
  Float { bits: int }
  Bool; String; Char; Nil; Never
  Array { elem: ref Type; size: int }
  Slice { elem: ref Type }
  Tuple { elems: Vec<ref Type> }
  Map { key: ref Type; value: ref Type }
  Fn { params: Vec<ref Type>; ret: ref Type; is_async: bool }
  Struct { name: string; fields: Vec<(string, ref Type)>; generics: Vec<ref Type> }
  Enum { name: string; variants: Vec<(string, Vec<ref Type>)>; generics: Vec<ref Type> }
  Trait { name: string; methods: Vec<(string, ref Type)> }
  Ref { inner: ref Type; is_mut: bool }
  Ptr { inner: ref Type; is_mut: bool }
  Var { id: int }
  Generic { name: string; bounds: Vec<ref Type> }
  SelfType
  Option { inner: ref Type }
  Result { ok: ref Type; err: ref Type }
}

struct TypeEnv {
  parent: ref TypeEnv
  bindings: Map<string, ref Type>
  types: Map<string, ref Type>
  traits: Map<string, ref Type>
  impls: Vec<(ref Type, ref Type)>
}

fn TypeEnv.new() -> TypeEnv { return TypeEnv { parent: nil, bindings: Map.new<string, ref Type>(), types: Map.new<string, ref Type>(), traits: Map.new<string, ref Type>(), impls: Vec.new<(ref Type, ref Type)>() } }
fn TypeEnv.child(parent: ref TypeEnv) -> TypeEnv { return TypeEnv { parent: parent, bindings: Map.new<string, ref Type>(), types: Map.new<string, ref Type>(), traits: Map.new<string, ref Type>(), impls: Vec.new<(ref Type, ref Type)>() } }

fn TypeEnv.lookup(self: ref TypeEnv, name: string) -> ref Type { if self.bindings.contains_key(name) { return self.bindings.get(name) } if self.parent != nil { return self.parent.lookup(name) } return nil }
fn TypeEnv.lookup_type(self: ref TypeEnv, name: string) -> ref Type { if self.types.contains_key(name) { return self.types.get(name) } if self.parent != nil { return self.parent.lookup_type(name) } return nil }
fn TypeEnv.define(self: ref mut TypeEnv, name: string, type: ref Type) { self.bindings.insert(name, type) }
fn TypeEnv.define_type(self: ref mut TypeEnv, name: string, type: ref Type) { self.types.insert(name, type) }
fn TypeEnv.define_trait(self: ref mut TypeEnv, name: string, type: ref Type) { self.traits.insert(name, type) }

fn TypeEnv.types_equal(self: ref TypeEnv, a: ref Type, b: ref Type) -> bool {
  match (a, b) {
    (Type.Int { bits: b1, signed: s1 }, Type.Int { bits: b2, signed: s2 }) => b1 == b2 and s1 == s2,
    (Type.Float { bits: b1 }, Type.Float { bits: b2 }) => b1 == b2,
    (Type.Bool, Type.Bool) => true, (Type.String, Type.String) => true, (Type.Char, Type.Char) => true, (Type.Nil, Type.Nil) => true, (Type.Never, Type.Never) => true,
    (Type.Array { elem: e1, size: s1 }, Type.Array { elem: e2, size: s2 }) => s1 == s2 and self.types_equal(e1, e2),
    (Type.Slice { elem: e1 }, Type.Slice { elem: e2 }) => self.types_equal(e1, e2),
    (Type.Tuple { elems: e1 }, Type.Tuple { elems: e2 }) => { if e1.len() != e2.len() { return false } for i in 0..e1.len() { if !self.types_equal(e1[i], e2[i]) { return false } } return true },
    (Type.Map { key: k1, value: v1 }, Type.Map { key: k2, value: v2 }) => self.types_equal(k1, k2) and self.types_equal(v1, v2),
    (Type.Fn { params: p1, ret: r1, is_async: a1 }, Type.Fn { params: p2, ret: r2, is_async: a2 }) => { if a1 != a2 or p1.len() != p2.len() { return false } for i in 0..p1.len() { if !self.types_equal(p1[i], p2[i]) { return false } } self.types_equal(r1, r2) },
    (Type.Ref { inner: i1, is_mut: m1 }, Type.Ref { inner: i2, is_mut: m2 }) => m1 == m2 and self.types_equal(i1, i2),
    (Type.Ptr { inner: i1, is_mut: m1 }, Type.Ptr { inner: i2, is_mut: m2 }) => m1 == m2 and self.types_equal(i1, i2),
    (Type.Var { id: id1 }, Type.Var { id: id2 }) => id1 == id2,
    (Type.Generic { name: n1 }, Type.Generic { name: n2 }) => n1 == n2,
    (Type.SelfType, Type.SelfType) => true,
    (Type.Option { inner: i1 }, Type.Option { inner: i2 }) => self.types_equal(i1, i2),
    (Type.Result { ok: o1, err: e1 }, Type.Result { ok: o2, err: e2 }) => self.types_equal(o1, o2) and self.types_equal(e1, e2),
    _ => false
  }
}

struct TypeChecker { env: ref TypeEnv; var_counter: int; errors: Vec<TypeError>; current_fn_return: ref Type; in_loop: bool; in_async: bool }

fn TypeChecker.new() -> TypeChecker {
  let env = alloc(TypeEnv.new())
  env.define_type("int", alloc(Type.Int { bits: 64, signed: true }))
  env.define_type("i8", alloc(Type.Int { bits: 8, signed: true }))
  env.define_type("i16", alloc(Type.Int { bits: 16, signed: true }))
  env.define_type("i32", alloc(Type.Int { bits: 32, signed: true }))
  env.define_type("i64", alloc(Type.Int { bits: 64, signed: true }))
  env.define_type("uint", alloc(Type.Int { bits: 64, signed: false }))
  env.define_type("u8", alloc(Type.Int { bits: 8, signed: false }))
  env.define_type("u16", alloc(Type.Int { bits: 16, signed: false }))
  env.define_type("u32", alloc(Type.Int { bits: 32, signed: false }))
  env.define_type("u64", alloc(Type.Int { bits: 64, signed: false }))
  env.define_type("f32", alloc(Type.Float { bits: 32 }))
  env.define_type("f64", alloc(Type.Float { bits: 64 }))
  env.define_type("bool", alloc(Type.Bool))
  env.define_type("string", alloc(Type.String))
  env.define_type("char", alloc(Type.Char))
  env.define_type("nil", alloc(Type.Nil))
  env.define_type("never", alloc(Type.Never))
  return TypeChecker { env: env, var_counter: 0, errors: Vec.new<TypeError>(), current_fn_return: alloc(Type.Nil), in_loop: false, in_async: false }
}

fn TypeChecker.fresh_var(self: ref mut TypeChecker) -> ref Type { self.var_counter = self.var_counter + 1; return alloc(Type.Var { id: self.var_counter }) }
fn TypeChecker.error(self: ref mut TypeChecker, msg: string, span: Span) { self.errors.push(TypeError.new(msg, span)) }

pub fn TypeChecker.check_program(self: ref mut TypeChecker, program: Program) -> bool { for stmt in program.stmts { self.check_stmt(stmt) } return self.errors.len() == 0 }

fn TypeChecker.check_stmt(self: ref mut TypeChecker, stmt: ref Stmt) -> ref Type {
  match stmt {
    Stmt.ExprStmt { expr: e } => self.check_expr(e),
    Stmt.VarDecl { name: n, type_expr: te, init: i, is_const: c, is_mut: m } => {
      let mut expected = self.fresh_var(); if te is not TypeExpr.Infer { expected = self.type_from_expr(te) }
      let actual = self.check_expr(i); if !self.unify(expected, actual) { self.error("Type mismatch: expected " + self.type_to_string(expected) + ", got " + self.type_to_string(actual), stmt.span) }
      self.env.define(n, actual); return alloc(Type.Nil)
    }
    Stmt.FnDecl { name: n, params: p, return_type: rt, body: b, generics: g } => self.check_fn_decl(n, p, rt, b, g, stmt.span),
    Stmt.StructDecl { name: n, fields: f, generics: g } => {
      let mut ft = Vec.new<(string, ref Type)>(); for field in f { ft.push((field.name, self.type_from_expr(field.type_expr))) }
      let mut gt = Vec.new<ref Type>(); for gen in g { gt.push(alloc(Type.Generic { name: gen.name, bounds: Vec.new<ref Type>() })) }
      self.env.define_type(n, alloc(Type.Struct { name: n, fields: ft, generics: gt })); return alloc(Type.Nil)
    }
    Stmt.EnumDecl { name: n, variants: v, generics: g } => {
      let mut vt = Vec.new<(string, Vec<ref Type>)>(); for variant in v { let mut ft = Vec.new<ref Type>(); for field in variant.fields { ft.push(self.type_from_expr(field.type_expr)) } vt.push((variant.name, ft)) }
      let mut gt = Vec.new<ref Type>(); for gen in g { gt.push(alloc(Type.Generic { name: gen.name, bounds: Vec.new<ref Type>() })) }
      self.env.define_type(n, alloc(Type.Enum { name: n, variants: vt, generics: gt })); return alloc(Type.Nil)
    }
    Stmt.TraitDecl { name: n, methods: m } => {
      let mut mt = Vec.new<(string, ref Type)>(); for method in m { let mut pt = Vec.new<ref Type>(); for param in method.params { pt.push(self.type_from_expr(param.type_expr)) } let rt = self.type_from_expr(method.return_type); mt.push((method.name, alloc(Type.Fn { params: pt, ret: rt, is_async: method.is_async }))) }
      self.env.define_trait(n, alloc(Type.Trait { name: n, methods: mt })); return alloc(Type.Nil)
    }
    Stmt.ImplDecl { methods: m } => { for method in m { self.check_stmt(method) } return alloc(Type.Nil) }
    Stmt.Import { } => alloc(Type.Nil),
    Stmt.TypeDecl { name: n, type_expr: te } => { self.env.define_type(n, self.type_from_expr(te)); return alloc(Type.Nil) }
    Stmt.ModuleDecl { stmts: s } => { let old = self.env; self.env = alloc(TypeEnv.child(old)); for st in s { self.check_stmt(st) } self.env = old; return alloc(Type.Nil) }
    Stmt.UseDecl { } => alloc(Type.Nil)
  }
}

fn TypeChecker.check_fn_decl(self: ref mut TypeChecker, name: string, params: Vec<Param>, return_type_expr: ref TypeExpr, body: ref Expr, generics: Vec<GenericParam>, span: Span) -> ref Type {
  let old_env = self.env; self.env = alloc(TypeEnv.child(old_env))
  for gen in generics { self.env.define_type(gen.name, alloc(Type.Generic { name: gen.name, bounds: Vec.new<ref Type>() })) }
  let mut pt = Vec.new<ref Type>(); for param in params { let ptype = self.type_from_expr(param.type_expr); pt.push(ptype); self.env.define(param.name, ptype) }
  let ret = self.type_from_expr(return_type_expr); let old_ret = self.current_fn_return; self.current_fn_return = ret
  let body_type = self.check_expr(body); if !self.unify(ret, body_type) { self.error("Return type mismatch: expected " + self.type_to_string(ret) + ", got " + self.type_to_string(body_type), span) }
  self.current_fn_return = old_ret; self.env = old_env
  let fn_type = alloc(Type.Fn { params: pt, ret: ret, is_async: false }); self.env.define(name, fn_type); return fn_type
}

fn TypeChecker.check_expr(self: ref mut TypeChecker, expr: ref Expr) -> ref Type {
  match expr {
    Expr.NumberLit { } => alloc(Type.Float { bits: 64 }),
    Expr.StringLit { } => alloc(Type.String),
    Expr.BoolLit { } => alloc(Type.Bool),
    Expr.NilLit => alloc(Type.Nil),
    Expr.Ident { name: n } => { let found = self.env.lookup(n); if found == nil { self.error("Undefined: " + n, expr.span); return self.fresh_var() } return found }
    Expr.Binary { op: o, left: l, right: r } => { let lt = self.check_expr(l); let rt = self.check_expr(r); return self.check_binary_op(o, lt, rt, expr.span) }
    Expr.Unary { op: o, operand: opd } => { let ot = self.check_expr(opd); return self.check_unary_op(o, ot, expr.span) }
    Expr.Assign { target: t, value: v } => { let tt = self.check_expr(t); let vt = self.check_expr(v); self.unify(tt, vt); return tt }
    Expr.Call { callee: c, args: a } => { let ct = self.check_expr(c); let mut at = Vec.new<ref Type>(); for arg in a { at.push(self.check_expr(arg)) } return self.check_call(ct, at, expr.span) }
    Expr.Member { object: o, member: m } => { let ot = self.check_expr(o); return self.check_member(ot, m, expr.span) }
    Expr.Index { object: o, index: i } => { let ot = self.check_expr(o); let it = self.check_expr(i); return self.check_index(ot, it, expr.span) }
    Expr.ArrayLit { elements: e } => { if e.len() == 0 { return alloc(Type.Slice { elem: self.fresh_var() }) } let ft = self.check_expr(e[0]); for i in 1..e.len() { self.unify(ft, self.check_expr(e[i])) } return alloc(Type.Slice { elem: ft }) }
    Expr.TupleLit { elements: e } => { let mut et = Vec.new<ref Type>(); for elem in e { et.push(self.check_expr(elem)) } return alloc(Type.Tuple { elems: et }) }
    Expr.MapLit { entries: e } => { if e.len() == 0 { return alloc(Type.Map { key: self.fresh_var(), value: self.fresh_var() }) } let fk = self.check_expr(e[0]._0); let fv = self.check_expr(e[0]._1); for i in 1..e.len() { self.unify(fk, self.check_expr(e[i]._0)); self.unify(fv, self.check_expr(e[i]._1)) } return alloc(Type.Map { key: fk, value: fv }) }
    Expr.StructLit { name: n } => { let t = self.env.lookup_type(n); if t == nil { self.error("Unknown struct: " + n, expr.span); return self.fresh_var() } return t }
    Expr.Lambda { params: p, return_type: rt, body: b } => { let old = self.env; self.env = alloc(TypeEnv.child(old)); let mut pt = Vec.new<ref Type>(); for param in p { let ptype = self.type_from_expr(param.type_expr); pt.push(ptype); self.env.define(param.name, ptype) } let r = self.type_from_expr(rt); let bt = self.check_expr(b); self.unify(r, bt); self.env = old; return alloc(Type.Fn { params: pt, ret: r, is_async: false }) }
    Expr.Block { stmts: s, expr: e } => { let old = self.env; self.env = alloc(TypeEnv.child(old)); for st in s { self.check_stmt(st) } let res = self.check_expr(e); self.env = old; return res }
    Expr.If { cond: c, then_branch: t, else_branch: e } => { let ct = self.check_expr(c); self.unify(ct, alloc(Type.Bool)); let tt = self.check_expr(t); let et = self.check_expr(e); self.unify(tt, et); return tt }
    Expr.While { cond: c, body: b } => { let old = self.in_loop; self.in_loop = true; let ct = self.check_expr(c); self.unify(ct, alloc(Type.Bool)); self.check_expr(b); self
