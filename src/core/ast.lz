// Luazi AST Definitions
// Immutable tree structure with visitor pattern support

pub type Node = Program | Block | VarDecl | FnDecl | IfStmt | WhileStmt | ForStmt | ForInStmt | MatchStmt | ReturnStmt | BreakStmt | ContinueStmt | ExprStmt | StructDecl | EnumDecl | TraitDecl | ImplDecl | ImportDecl | ExportDecl | DeferStmt | GuardStmt | TypeAliasDecl | Expression

pub type Program = {
  kind: string,
  body: [Statement],
  sourceFile: string,
}

pub type Statement = Block | VarDecl | FnDecl | IfStmt | WhileStmt | ForStmt | ForInStmt | MatchStmt | ReturnStmt | BreakStmt | ContinueStmt | ExprStmt | StructDecl | EnumDecl | TraitDecl | ImplDecl | ImportDecl | ExportDecl | DeferStmt | GuardStmt | TypeAliasDecl

pub type Block = {
  kind: string,
  statements: [Statement],
  span: Span,
}

pub type VarDecl = {
  kind: string,
  name: string,
  isConst: bool,
  isMut: bool,
  typeAnnotation: TypeExpr | nil,
  initializer: Expression | nil,
  span: Span,
}

pub type FnDecl = {
  kind: string,
  name: string,
  isAsync: bool,
  isPub: bool,
  generics: [GenericParam],
  params: [Param],
  returnType: TypeExpr | nil,
  body: Block,
  span: Span,
}

pub type Param = {
  name: string,
  type: TypeExpr | nil,
  defaultValue: Expression | nil,
  isRef: bool,
  isMut: bool,
  span: Span,
}

pub type IfStmt = {
  kind: string,
  condition: Expression,
  thenBranch: Block,
  elseBranch: Block | IfStmt | nil,
  span: Span,
}

pub type WhileStmt = {
  kind: string,
  condition: Expression,
  body: Block,
  span: Span,
}

pub type ForStmt = {
  kind: string,
  init: VarDecl | ExprStmt | nil,
  condition: Expression | nil,
  increment: Expression | nil,
  body: Block,
  span: Span,
}

pub type ForInStmt = {
  kind: string,
  varName: string,
  isConst: bool,
  iterable: Expression,
  body: Block,
  span: Span,
}

pub type MatchStmt = {
  kind: string,
  expression: Expression,
  arms: [MatchArm],
  span: Span,
}

pub type MatchArm = {
  pattern: Pattern,
  guard: Expression | nil,
  body: Expression | Block,
  span: Span,
}

pub type Pattern = LiteralPattern | VariablePattern | ArrayPattern | StructPattern | EnumPattern | WildcardPattern | RestPattern

pub type LiteralPattern = { kind: string, value: Literal, span: Span }
pub type VariablePattern = { kind: string, name: string, span: Span }
pub type ArrayPattern = { kind: string, elements: [Pattern], rest: Pattern | nil, span: Span }
pub type StructPattern = { kind: string, name: string, fields: [(string, Pattern)], span: Span }
pub type EnumPattern = { kind: string, enumName: string, variant: string, fields: [Pattern], span: Span }
pub type WildcardPattern = { kind: string, span: Span }
pub type RestPattern = { kind: string, name: string | nil, span: Span }

pub type ReturnStmt = { kind: string, value: Expression | nil, span: Span }
pub type BreakStmt = { kind: string, label: string | nil, span: Span }
pub type ContinueStmt = { kind: string, label: string | nil, span: Span }

pub type ExprStmt = {
  kind: string,
  expression: Expression,
  span: Span,
}

pub type StructDecl = {
  kind: string,
  name: string,
  isPub: bool,
  generics: [GenericParam],
  fields: [StructField],
  methods: [FnDecl],
  span: Span,
}

pub type StructField = {
  name: string,
  type: TypeExpr,
  defaultValue: Expression | nil,
  isPub: bool,
  span: Span,
}

pub type EnumDecl = {
  kind: string,
  name: string,
  isPub: bool,
  generics: [GenericParam],
  variants: [EnumVariant],
  span: Span,
}

pub type EnumVariant = {
  name: string,
  fields: [EnumField],
  discriminant: number | nil,
  span: Span,
}

pub type EnumField = {
  name: string | nil,
  type: TypeExpr,
  span: Span,
}

pub type TraitDecl = {
  kind: string,
  name: string,
  isPub: bool,
  generics: [GenericParam],
  methods: [FnSignature],
  associatedTypes: [string],
  span: Span,
}

pub type FnSignature = {
  name: string,
  generics: [GenericParam],
  params: [Param],
  returnType: TypeExpr | nil,
  span: Span,
}

pub type ImplDecl = {
  kind: string,
  target: TypeExpr,
  trait: TypeExpr | nil,
  generics: [GenericParam],
  methods: [FnDecl],
  span: Span,
}

pub type ImportDecl = {
  kind: string,
  path: string,
  items: [ImportItem] | nil,
  alias: string | nil,
  span: Span,
}

pub type ImportItem = {
  name: string,
  alias: string | nil,
  isType: bool,
  span: Span,
}

pub type ExportDecl = {
  kind: string,
  declaration: Statement,
  span: Span,
}

pub type DeferStmt = {
  kind: string,
  expression: Expression,
  span: Span,
}

pub type GuardStmt = {
  kind: string,
  condition: Expression,
  elseBranch: Block,
  span: Span,
}

pub type TypeAliasDecl = {
  kind: string,
  name: string,
  generics: [GenericParam],
  type: TypeExpr,
  span: Span,
}

pub type GenericParam = {
  name: string,
  bounds: [TypeExpr],
  defaultType: TypeExpr | nil,
  span: Span,
}

// Expressions

pub type Expression = Literal | Identifier | BinaryExpr | UnaryExpr | TernaryExpr | CallExpr | MemberExpr | IndexExpr | AssignmentExpr | LambdaExpr | ArrayExpr | TableExpr | TupleExpr | RangeExpr | SpreadExpr | AwaitExpr | YieldExpr | TryExpr | TypeCastExpr | TypeCheckExpr | BlockExpr

pub type Literal = { kind: string, value: string | number | bool | nil, raw: string, span: Span }
pub type Identifier = { kind: string, name: string, span: Span }

pub type BinaryExpr = {
  kind: string,
  left: Expression,
  operator: string,
  right: Expression,
  span: Span,
}

pub type UnaryExpr = {
  kind: string,
  operator: string,
  operand: Expression,
  span: Span,
}

pub type TernaryExpr = {
  kind: string,
  condition: Expression,
  thenExpr: Expression,
  elseExpr: Expression,
  span: Span,
}

pub type CallExpr = {
  kind: string,
  callee: Expression,
  args: [Argument],
  isAsync: bool,
  isTail: bool,
  span: Span,
}

pub type Argument = {
  name: string | nil,
  value: Expression,
  isSpread: bool,
  span: Span,
}

pub type MemberExpr = {
  kind: string,
  object: Expression,
  property: string,
  isOptional: bool,
  span: Span,
}

pub type IndexExpr = {
  kind: string,
  object: Expression,
  index: Expression,
  isOptional: bool,
  span: Span,
}

pub type AssignmentExpr = {
  kind: string,
  target: Expression,
  operator: string,
  value: Expression,
  span: Span,
}

pub type LambdaExpr = {
  kind: string,
  params: [Param],
  returnType: TypeExpr | nil,
  body: Block | Expression,
  isAsync: bool,
  span: Span,
}

pub type ArrayExpr = {
  kind: string,
  elements: [Expression],
  span: Span,
}

pub type TableEntry = {
  key: Expression | string,
  value: Expression,
  isComputed: bool,
  span: Span,
}

pub type TableExpr = {
  kind: string,
  entries: [TableEntry],
  span: Span,
}

pub type TupleExpr = {
  kind: string,
  elements: [Expression],
  span: Span,
}

pub type RangeExpr = {
  kind: string,
  start: Expression | nil,
  end: Expression | nil,
  inclusive: bool,
  span: Span,
}

pub type SpreadExpr = { kind: string, expression: Expression, span: Span }
pub type AwaitExpr = { kind: string, expression: Expression, span: Span }
pub type YieldExpr = { kind: string, expression: Expression | nil, span: Span }

pub type TryExpr = {
  kind: string,
  expression: Expression,
  catchVar: string | nil,
  catchBody: Block | nil,
  finallyBody: Block | nil,
  span: Span,
}

pub type TypeCastExpr = {
  kind: string,
  expression: Expression,
  targetType: TypeExpr,
  isSafe: bool,
  span: Span,
}

pub type TypeCheckExpr = {
  kind: string,
  expression: Expression,
  checkType: TypeExpr,
  span: Span,
}

pub type BlockExpr = { kind: string, block: Block, span: Span }

// Type Expressions

pub type TypeExpr = NamedType | GenericType | FunctionType | TupleType | ArrayType | TableType | OptionalType | UnionType | IntersectionType | RefType | MutType | SelfType | WildcardType | LiteralType

pub type NamedType = { kind: string, name: string, span: Span }
pub type GenericType = { kind: string, name: string, args: [TypeExpr], span: Span }
pub type FunctionType = { kind: string, params: [TypeExpr], returnType: TypeExpr, span: Span }
pub type TupleType = { kind: string, elements: [TypeExpr], span: Span }
pub type ArrayType = { kind: string, element: TypeExpr, span: Span }
pub type TableType = { kind: string, key: TypeExpr, value: TypeExpr, span: Span }
pub type OptionalType = { kind: string, inner: TypeExpr, span: Span }
pub type UnionType = { kind: string, types: [TypeExpr], span: Span }
pub type IntersectionType = { kind: string, types: [TypeExpr], span: Span }
pub type RefType = { kind: string, inner: TypeExpr, span: Span }
pub type MutType = { kind: string, inner: TypeExpr, span: Span }
pub type SelfType = { kind: string, span: Span }
pub type WildcardType = { kind: string, span: Span }
pub type LiteralType = { kind: string, value: Literal, span: Span }

// Span

pub type Span = {
  line: number,
  column: number,
  offset: number,
  length: number,
  source: string,
}

pub fn createSpan(line: number, column: number, offset: number, length: number, source: string) -> Span {
  return { line: line, column: column, offset: offset, length: length, source: source }
}
