// Luazi Tokenizer
// Single-pass scanner with look-ahead and full Unicode support

pub type Token = {
  type: TokenType,
  value: string,
  raw: string,
  span: Span,
}

pub type Span = {
  line: number,
  column: number,
  offset: number,
  length: number,
  source: string,
}

pub enum TokenType {
  NUMBER,
  STRING,
  IDENTIFIER,
  TEMPLATE,
  LET,
  CONST,
  VAR,
  MUT,
  FN,
  ASYNC,
  AWAIT,
  RETURN,
  YIELD,
  IF,
  ELSE,
  WHILE,
  FOR,
  IN,
  BREAK,
  CONTINUE,
  MATCH,
  TRY,
  CATCH,
  FINALLY,
  THROW,
  DEFER,
  GUARD,
  LOOP,
  TYPE,
  STRUCT,
  ENUM,
  TRAIT,
  IMPL,
  WHERE,
  PUB,
  PRIV,
  REF,
  UNSAFE,
  IMPORT,
  EXPORT,
  FROM,
  AS,
  IS,
  SELF,
  SUPER,
  NIL,
  TRUE,
  FALSE,
  AND,
  OR,
  NOT,
  PLUS,
  MINUS,
  STAR,
  SLASH,
  PERCENT,
  CARET,
  BANG,
  TILDE,
  AMPERSAND,
  PIPE,
  HASH,
  QUESTION,
  AT,
  DOLLAR,
  PLUS_EQ,
  MINUS_EQ,
  STAR_EQ,
  SLASH_EQ,
  PERCENT_EQ,
  CARET_EQ,
  AMPERSAND_EQ,
  PIPE_EQ,
  EQ,
  NEQ,
  LT,
  LE,
  GT,
  GE,
  ASSIGN,
  FAT_ARROW,
  THIN_ARROW,
  LPAREN,
  RPAREN,
  LBRACE,
  RBRACE,
  LBRACKET,
  RBRACKET,
  COLON,
  DOUBLE_COLON,
  SEMICOLON,
  COMMA,
  DOT,
  ELLIPSIS,
  OPTIONAL_CHAIN,
  NULL_COALESCE,
  RANGE,
  RANGE_INCLUSIVE,
  NEWLINE,
  EOF,
  COMMENT,
  DOC_COMMENT,
  UNKNOWN,
  UNDERSCORE,
}

pub struct Tokenizer {
  source: string,
  pos: number,
  line: number,
  column: number,
  startLine: number,
  startCol: number,
  startPos: number,
  tokens: [Token],
  atLineStart: bool,
  fileName: string,
}

impl Tokenizer {
  pub fn new(source: string, fileName: string) -> Self {
    Self {
      source: source,
      pos: 0,
      line: 1,
      column: 1,
      startLine: 1,
      startCol: 1,
      startPos: 0,
      tokens: [],
      atLineStart: true,
      fileName: fileName,
    }
  }

  pub fn tokenize(self) -> [Token] {
    while !self.isAtEnd() {
      self.startToken()
      self.scanToken()
    }
    self.tokens.push(self.makeToken(TokenType.EOF, ""))
    return self.tokens
  }

  fn scanToken(self) {
    let c = self.advance()

    if c == " " || c == "	" {
      return
    }

    if c == "
" || c == "
" {
      self.handleNewline(c)
      return
    }

    self.atLineStart = false

    if c == "/" && self.peek() == "/" {
      self.readLineComment()
      return
    }

    if c == "/" && self.peek() == "*" {
      if self.peek(1) == "*" {
        self.readDocComment()
      } else {
        self.readBlockComment()
      }
      return
    }

    if self.isDigit(c) || (c == "." && self.isDigit(self.peek())) {
      self.readNumber()
      return
    }

    if c == """ || c == "'" {
      self.readString(c)
      return
    }

    if c == "`" {
      self.readTemplate()
      return
    }

    if self.isAlpha(c) || c == "_" {
      self.readIdentifier()
      return
    }

    match c {
      "+" => {
        if self.match("=") {
          self.addToken(TokenType.PLUS_EQ)
        } else {
          self.addToken(TokenType.PLUS)
        }
      }
      "-" => {
        if self.match(">") {
          self.addToken(TokenType.THIN_ARROW)
        } else if self.match("=") {
          self.addToken(TokenType.MINUS_EQ)
        } else {
          self.addToken(TokenType.MINUS)
        }
      }
      "*" => {
        if self.match("=") {
          self.addToken(TokenType.STAR_EQ)
        } else {
          self.addToken(TokenType.STAR)
        }
      }
      "/" => {
        if self.match("=") {
          self.addToken(TokenType.SLASH_EQ)
        } else {
          self.addToken(TokenType.SLASH)
        }
      }
      "%" => {
        if self.match("=") {
          self.addToken(TokenType.PERCENT_EQ)
        } else {
          self.addToken(TokenType.PERCENT)
        }
      }
      "^" => {
        if self.match("=") {
          self.addToken(TokenType.CARET_EQ)
        } else {
          self.addToken(TokenType.CARET)
        }
      }
      "&" => {
        if self.match("=") {
          self.addToken(TokenType.AMPERSAND_EQ)
        } else {
          self.addToken(TokenType.AMPERSAND)
        }
      }
      "|" => {
        if self.match("=") {
          self.addToken(TokenType.PIPE_EQ)
        } else {
          self.addToken(TokenType.PIPE)
        }
      }
      "=" => {
        if self.match(">") {
          self.addToken(TokenType.FAT_ARROW)
        } else if self.match("=") {
          self.addToken(TokenType.EQ)
        } else {
          self.addToken(TokenType.ASSIGN)
        }
      }
      "!" => {
        if self.match("=") {
          self.addToken(TokenType.NEQ)
        } else {
          self.addToken(TokenType.BANG)
        }
      }
      "<" => {
        if self.match("=") {
          self.addToken(TokenType.LE)
        } else {
          self.addToken(TokenType.LT)
        }
      }
      ">" => {
        if self.match("=") {
          self.addToken(TokenType.GE)
        } else {
          self.addToken(TokenType.GT)
        }
      }
      ":" => {
        if self.match(":") {
          self.addToken(TokenType.DOUBLE_COLON)
        } else {
          self.addToken(TokenType.COLON)
        }
      }
      "." => {
        if self.match(".") {
          if self.match("=") {
            self.addToken(TokenType.RANGE_INCLUSIVE)
          } else {
            self.addToken(TokenType.RANGE)
          }
        } else if self.match("?") {
          self.addToken(TokenType.OPTIONAL_CHAIN)
        } else {
          self.addToken(TokenType.DOT)
        }
      }
      "?" => {
        if self.match("?") {
          self.addToken(TokenType.NULL_COALESCE)
        } else if self.match(".") {
          self.addToken(TokenType.OPTIONAL_CHAIN)
        } else {
          self.addToken(TokenType.QUESTION)
        }
      }
      "(" => self.addToken(TokenType.LPAREN)
      ")" => self.addToken(TokenType.RPAREN)
      "{" => self.addToken(TokenType.LBRACE)
      "}" => self.addToken(TokenType.RBRACE)
      "[" => self.addToken(TokenType.LBRACKET)
      "]" => self.addToken(TokenType.RBRACKET)
      ";" => self.addToken(TokenType.SEMICOLON)
      "," => self.addToken(TokenType.COMMA)
      "~" => self.addToken(TokenType.TILDE)
      "#" => self.addToken(TokenType.HASH)
      "@" => self.addToken(TokenType.AT)
      "$" => self.addToken(TokenType.DOLLAR)
      "_" => self.addToken(TokenType.UNDERSCORE)
      _ => self.addToken(TokenType.UNKNOWN)
    }
  }

  fn readNumber(self) {
    let isFloat = false
    let isHex = false
    let isBin = false
    let isOct = false

    if self.source[self.startPos] == "0" {
      let next = self.peek()
      if next == "x" || next == "X" {
        isHex = true
        self.advance()
      } else if next == "b" || next == "B" {
        isBin = true
        self.advance()
      } else if next == "o" || next == "O" {
        isOct = true
        self.advance()
      }
    }

    while !self.isAtEnd() {
      let c = self.peek()
      if isHex && self.isHexDigit(c) {
        self.advance()
        continue
      }
      if isBin && (c == "0" || c == "1") {
        self.advance()
        continue
      }
      if isOct && c >= "0" && c <= "7" {
        self.advance()
        continue
      }
      if self.isDigit(c) {
        self.advance()
        continue
      }
      if c == "." && !isFloat && self.isDigit(self.peek(1)) {
        isFloat = true
        self.advance()
        continue
      }
      if (c == "e" || c == "E") && !isHex && !isBin && !isOct && (self.isDigit(self.peek(1)) || self.peek(1) == "-" || self.peek(1) == "+") {
        isFloat = true
        self.advance()
        if self.peek() == "-" || self.peek() == "+" {
          self.advance()
        }
        continue
      }
      if c == "_" {
        self.advance()
        continue
      }
      break
    }

    self.addToken(TokenType.NUMBER)
  }

  fn readString(self, quote: string) {
    while !self.isAtEnd() && self.peek() != quote {
      if self.peek() == "\" {
        self.advance()
        if !self.isAtEnd() {
          self.advance()
        }
      } else {
        self.advance()
      }
    }

    if !self.isAtEnd() {
      self.advance()
    }

    self.addToken(TokenType.STRING)
  }

  fn readTemplate(self) {
    while !self.isAtEnd() && self.peek() != "`" {
      if self.peek() == "$" && self.peek(1) == "{" {
        self.addToken(TokenType.TEMPLATE)
        return
      }
      if self.peek() == "\" {
        self.advance()
        if !self.isAtEnd() {
          self.advance()
        }
      } else {
        self.advance()
      }
    }
    if !self.isAtEnd() {
      self.advance()
    }
    self.addToken(TokenType.TEMPLATE)
  }

  fn readIdentifier(self) {
    while !self.isAtEnd() && (self.isAlphaNum(self.peek()) || self.peek() == "_") {
      self.advance()
    }

    let text = self.source.substring(self.startPos, self.pos)
    let type = self.keywordType(text)
    self.addToken(type)
  }

  fn keywordType(self, text: string) -> TokenType {
    match text {
      "let" => TokenType.LET
      "const" => TokenType.CONST
      "var" => TokenType.VAR
      "mut" => TokenType.MUT
      "fn" => TokenType.FN
      "async" => TokenType.ASYNC
      "await" => TokenType.AWAIT
      "return" => TokenType.RETURN
      "yield" => TokenType.YIELD
      "if" => TokenType.IF
      "else" => TokenType.ELSE
      "while" => TokenType.WHILE
      "for" => TokenType.FOR
      "in" => TokenType.IN
      "break" => TokenType.BREAK
      "continue" => TokenType.CONTINUE
      "match" => TokenType.MATCH
      "try" => TokenType.TRY
      "catch" => TokenType.CATCH
      "finally" => TokenType.FINALLY
      "throw" => TokenType.THROW
      "defer" => TokenType.DEFER
      "guard" => TokenType.GUARD
      "loop" => TokenType.LOOP
      "type" => TokenType.TYPE
      "struct" => TokenType.STRUCT
      "enum" => TokenType.ENUM
      "trait" => TokenType.TRAIT
      "impl" => TokenType.IMPL
      "where" => TokenType.WHERE
      "pub" => TokenType.PUB
      "priv" => TokenType.PRIV
      "ref" => TokenType.REF
      "unsafe" => TokenType.UNSAFE
      "import" => TokenType.IMPORT
      "export" => TokenType.EXPORT
      "from" => TokenType.FROM
      "as" => TokenType.AS
      "is" => TokenType.IS
      "self" => TokenType.SELF
      "super" => TokenType.SUPER
      "nil" => TokenType.NIL
      "true" => TokenType.TRUE
      "false" => TokenType.FALSE
      "and" => TokenType.AND
      "or" => TokenType.OR
      "not" => TokenType.NOT
      _ => TokenType.IDENTIFIER
    }
  }

  fn readLineComment(self) {
    while !self.isAtEnd() && self.peek() != "
" {
      self.advance()
    }
    self.addToken(TokenType.COMMENT)
  }

  fn readBlockComment(self) {
    let depth = 1
    while !self.isAtEnd() && depth > 0 {
      if self.peek() == "/" && self.peek(1) == "*" {
        depth = depth + 1
        self.advance()
        self.advance()
      } else if self.peek() == "*" && self.peek(1) == "/" {
        depth = depth - 1
        self.advance()
        self.advance()
      } else {
        self.advance()
      }
    }
    self.addToken(TokenType.COMMENT)
  }

  fn readDocComment(self) {
    self.advance()
    while !self.isAtEnd() && !(self.peek() == "*" && self.peek(1) == "/") {
      self.advance()
    }
    if !self.isAtEnd() {
      self.advance()
      self.advance()
    }
    self.addToken(TokenType.DOC_COMMENT)
  }

  fn handleNewline(self, c: string) {
    if c == "
" && self.peek() == "
" {
      self.advance()
    }
    self.line = self.line + 1
    self.column = 1
    self.atLineStart = true
  }

  fn startToken(self) {
    self.startLine = self.line
    self.startCol = self.column
    self.startPos = self.pos
  }

  fn advance(self) -> string {
    let c = self.source[self.pos]
    self.pos = self.pos + 1
    self.column = self.column + 1
    return c
  }

  fn peek(self, offset: number) -> string {
    let idx = self.pos + offset
    if idx < self.source.length {
      return self.source[idx]
    }
    return "␀"
  }

  fn match(self, expected: string) -> bool {
    if self.isAtEnd() || self.source[self.pos] != expected {
      return false
    }
    self.pos = self.pos + 1
    self.column = self.column + 1
    return true
  }

  fn isAtEnd(self) -> bool {
    return self.pos >= self.source.length
  }

  fn isDigit(self, c: string) -> bool {
    return c >= "0" && c <= "9"
  }

  fn isHexDigit(self, c: string) -> bool {
    return self.isDigit(c) || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
  }

  fn isAlpha(self, c: string) -> bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
  }

  fn isAlphaNum(self, c: string) -> bool {
    return self.isAlpha(c) || self.isDigit(c)
  }

  fn addToken(self, type: TokenType) {
    let value = self.source.substring(self.startPos, self.pos)
    self.tokens.push(self.makeToken(type, value))
  }

  fn makeToken(self, type: TokenType, value: string) -> Token {
    return {
      type: type,
      value: value,
      raw: value,
      span: {
        line: self.startLine,
        column: self.startCol,
        offset: self.startPos,
        length: self.pos - self.startPos,
        source: self.fileName,
      }
    }
  }
}

pub fn tokenize(source: string, fileName: string) -> [Token] {
  return Tokenizer.new(source, fileName).tokenize()
}
