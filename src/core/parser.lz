// Luazi Parser
// Recursive descent with Pratt parsing for expressions

import { Token, TokenType, Span } from "./tokenizer"
import * as AST from "./ast"

pub type ParseError = {
  message: string,
  span: Span,
}

pub struct Parser {
  tokens: [Token],
  pos: number,
}

impl Parser {
  pub fn new(tokens: [Token]) -> Self {
    return Self { tokens: tokens, pos: 0 }
  }

  pub fn parse(self) -> AST.Program {
    let statements: [AST.Statement] = []
    while !self.isAtEnd() {
      let stmt = self.parseStatement()
      if stmt != nil {
        statements.push(stmt)
      }
    }
    return { kind: "Program", body: statements, sourceFile: "" }
  }

  pub fn parseExpression(self, precedence: number) -> AST.Expression {
    if precedence == nil {
      precedence = 0
    }

    let token = self.advance()
    let left = self.parsePrefix(token)

    while precedence < self.getPrecedence() {
      let infixToken = self.advance()
      left = self.parseInfix(left, infixToken)
    }

    return left
  }

  fn parsePrefix(self, token: Token) -> AST.Expression {
    match token.type {
      TokenType.NUMBER => {
        return { kind: "Literal", value: token.value as number, raw: token.raw, span: token.span }
      }
      TokenType.STRING => {
        return { kind: "Literal", value: token.value, raw: token.raw, span: token.span }
      }
      TokenType.IDENTIFIER => {
        return { kind: "Identifier", name: token.value, span: token.span }
      }
      TokenType.NIL => {
        return { kind: "Literal", value: nil, raw: token.raw, span: token.span }
      }
      TokenType.TRUE => {
        return { kind: "Literal", value: true, raw: token.raw, span: token.span }
      }
      TokenType.FALSE => {
        return { kind: "Literal", value: false, raw: token.raw, span: token.span }
      }
      TokenType.MINUS => {
        return { kind: "Unary", operator: "-", operand: self.parseExpression(70), span: token.span }
      }
      TokenType.BANG => {
        return { kind: "Unary", operator: "!", operand: self.parseExpression(70), span: token.span }
      }
      TokenType.NOT => {
        return { kind: "Unary", operator: "!", operand: self.parseExpression(70), span: token.span }
      }
      TokenType.TILDE => {
        return { kind: "Unary", operator: "~", operand: self.parseExpression(70), span: token.span }
      }
      TokenType.HASH => {
        return { kind: "Unary", operator: "#", operand: self.parseExpression(70), span: token.span }
      }
      TokenType.REF => {
        return { kind: "Unary", operator: "ref", operand: self.parseExpression(70), span: token.span }
      }
      TokenType.MUT => {
        return { kind: "Unary", operator: "mut", operand: self.parseExpression(70), span: token.span }
      }
      TokenType.LPAREN => {
        let expr = self.parseExpression()
        self.consume(TokenType.RPAREN, "Expected ')' after expression")
        return expr
      }
      TokenType.LBRACKET => {
        let elements: [AST.Expression] = []
        if !self.check(TokenType.RBRACKET) {
          repeat {
            elements.push(self.parseExpression())
          } while self.match(TokenType.COMMA)
        }
        self.consume(TokenType.RBRACKET, "Expected ']' after array elements")
        return { kind: "Array", elements: elements, span: token.span }
      }
      TokenType.LBRACE => {
        return self.parseTableOrBlock()
      }
      TokenType.FN => {
        return self.parseLambda(token.span)
      }
      TokenType.ASYNC => {
        let lambda = self.parseLambda(token.span)
        return { kind: lambda.kind, params: lambda.params, returnType: lambda.returnType, body: lambda.body, isAsync: true, span: lambda.span }
      }
      TokenType.AWAIT => {
        return { kind: "Await", expression: self.parseExpression(70), span: token.span }
      }
      TokenType.TRY => {
        return self.parseTryExpression(token.span)
      }
      TokenType.MATCH => {
        return self.parseMatchExpression(token.span)
      }
      TokenType.IF => {
        return self.parseTernary(token.span)
      }
      _ => {
        panic("Unexpected token: " + token.value)
      }
    }
  }

  fn parseInfix(self, left: AST.Expression, token: Token) -> AST.Expression {
    match token.type {
      TokenType.PLUS => {
        return { kind: "Binary", left: left, operator: "+", right: self.parseExpression(50), span: token.span }
      }
      TokenType.MINUS => {
        return { kind: "Binary", left: left, operator: "-", right: self.parseExpression(50), span: token.span }
      }
      TokenType.STAR => {
        return { kind: "Binary", left: left, operator: "*", right: self.parseExpression(60), span: token.span }
      }
      TokenType.SLASH => {
        return { kind: "Binary", left: left, operator: "/", right: self.parseExpression(60), span: token.span }
      }
      TokenType.PERCENT => {
        return { kind: "Binary", left: left, operator: "%", right: self.parseExpression(60), span: token.span }
      }
      TokenType.CARET => {
        return { kind: "Binary", left: left, operator: "**", right: self.parseExpression(69), span: token.span }
      }
      TokenType.EQ => {
        return { kind: "Binary", left: left, operator: "==", right: self.parseExpression(40), span: token.span }
      }
      TokenType.NEQ => {
        return { kind: "Binary", left: left, operator: "!=", right: self.parseExpression(40), span: token.span }
      }
      TokenType.LT => {
        return { kind: "Binary", left: left, operator: "<", right: self.parseExpression(40), span: token.span }
      }
      TokenType.LE => {
        return { kind: "Binary", left: left, operator: "<=", right: self.parseExpression(40), span: token.span }
      }
      TokenType.GT => {
        return { kind: "Binary", left: left, operator: ">", right: self.parseExpression(40), span: token.span }
      }
      TokenType.GE => {
        return { kind: "Binary", left: left, operator: ">=", right: self.parseExpression(40), span: token.span }
      }
      TokenType.AND => {
        return { kind: "Binary", left: left, operator: "&&", right: self.parseExpression(30), span: token.span }
      }
      TokenType.OR => {
        return { kind: "Binary", left: left, operator: "||", right: self.parseExpression(20), span: token.span }
      }
      TokenType.AMPERSAND => {
        return { kind: "Binary", left: left, operator: "&", right: self.parseExpression(45), span: token.span }
      }
      TokenType.PIPE => {
        return { kind: "Binary", left: left, operator: "|", right: self.parseExpression(35), span: token.span }
      }
      TokenType.DOT => {
        let prop = self.consume(TokenType.IDENTIFIER, "Expected property name after '.'")
        return { kind: "Member", object: left, property: prop.value, isOptional: false, span: token.span }
      }
      TokenType.OPTIONAL_CHAIN => {
        let prop = self.consume(TokenType.IDENTIFIER, "Expected property name after '?.'")
        return { kind: "Member", object: left, property: prop.value, isOptional: true, span: token.span }
      }
      TokenType.LPAREN => {
        let args: [AST.Argument] = []
        if !self.check(TokenType.RPAREN) {
          repeat {
            let isSpread = self.match(TokenType.ELLIPSIS)
            let name: string | nil = nil
            if self.check(TokenType.IDENTIFIER) && self.peek(1).type == TokenType.ASSIGN {
              name = self.advance().value
              self.consume(TokenType.ASSIGN, "Expected '=' after named argument")
            }
            args.push({ name: name, value: self.parseExpression(), isSpread: isSpread, span: token.span })
          } while self.match(TokenType.COMMA)
        }
        self.consume(TokenType.RPAREN, "Expected ')' after arguments")
        return { kind: "Call", callee: left, args: args, isAsync: false, isTail: false, span: token.span }
      }
      TokenType.LBRACKET => {
        let index = self.parseExpression()
        let isOptional = self.match(TokenType.QUESTION)
        self.consume(TokenType.RBRACKET, "Expected ']' after index")
        return { kind: "Index", object: left, index: index, isOptional: isOptional, span: token.span }
      }
      TokenType.ASSIGN => {
        return { kind: "Assignment", target: left, operator: "=", value: self.parseExpression(10), span: token.span }
      }
      TokenType.PLUS_EQ => {
        return { kind: "Assignment", target: left, operator: "+=", value: self.parseExpression(10), span: token.span }
      }
      TokenType.MINUS_EQ => {
        return { kind: "Assignment", target: left, operator: "-=", value: self.parseExpression(10), span: token.span }
      }
      TokenType.STAR_EQ => {
        return { kind: "Assignment", target: left, operator: "*=", value: self.parseExpression(10), span: token.span }
      }
      TokenType.SLASH_EQ => {
        return { kind: "Assignment", target: left, operator: "/=", value: self.parseExpression(10), span: token.span }
      }
      TokenType.NULL_COALESCE => {
        return { kind: "Binary", left: left, operator: "??", right: self.parseExpression(25), span: token.span }
      }
      TokenType.RANGE => {
        return { kind: "Range", start: left, end: self.parseExpression(55), inclusive: false, span: token.span }
      }
      TokenType.RANGE_INCLUSIVE => {
        return { kind: "Range", start: left, end: self.parseExpression(55), inclusive: true, span: token.span }
      }
      TokenType.AS => {
        let targetType = self.parseTypeExpression()
        return { kind: "TypeCast", expression: left, targetType: targetType, isSafe: false, span: token.span }
      }
      TokenType.IS => {
        let checkType = self.parseTypeExpression()
        return { kind: "TypeCheck", expression: left, checkType: checkType, span: token.span }
      }
      _ => {
        return left
      }
    }
  }

  fn parseStatement(self) -> AST.Statement | nil {
    if self.match(TokenType.NEWLINE) || self.match(TokenType.COMMENT) || self.match(TokenType.DOC_COMMENT) {
      return nil
    }

    match self.current().type {
      TokenType.LET => self.parseVarDecl()
      TokenType.CONST => self.parseVarDecl()
      TokenType.VAR => self.parseVarDecl()
      TokenType.MUT => self.parseVarDecl()
      TokenType.PUB => {
        self.advance()
        return self.parsePubStatement()
      }
      TokenType.FN => self.parseFnDecl()
      TokenType.ASYNC => self.parseFnDecl()
      TokenType.IF => self.parseIf()
      TokenType.WHILE => self.parseWhile()
      TokenType.FOR => self.parseFor()
      TokenType.LOOP => self.parseLoop()
      TokenType.MATCH => self.parseMatchStmt()
      TokenType.RETURN => self.parseReturn()
      TokenType.BREAK => self.parseBreak()
      TokenType.CONTINUE => self.parseContinue()
      TokenType.STRUCT => self.parseStruct()
      TokenType.ENUM => self.parseEnum()
      TokenType.TRAIT => self.parseTrait()
      TokenType.IMPL => self.parseImpl()
      TokenType.IMPORT => self.parseImport()
      TokenType.EXPORT => self.parseExport()
      TokenType.DEFER => self.parseDefer()
      TokenType.GUARD => self.parseGuard()
      TokenType.TYPE => self.parseTypeAlias()
      _ => self.parseExprStmt()
    }
  }

  fn parseVarDecl(self) -> AST.VarDecl {
    let isConst = self.match(TokenType.CONST)
    let isMut = self.match(TokenType.MUT)
    let isVar = !isConst && !isMut && self.match(TokenType.VAR)
    let isLet = !isConst && !isMut && !isVar && self.match(TokenType.LET)

    if !isConst && !isMut && !isVar && !isLet {
      panic("Expected let, const, var, or mut")
    }

    let name = self.consume(TokenType.IDENTIFIER, "Expected variable name").value

    let typeAnnotation: AST.TypeExpr | nil = nil
    if self.match(TokenType.COLON) {
      typeAnnotation = self.parseTypeExpression()
    }

    let initializer: AST.Expression | nil = nil
    if self.match(TokenType.ASSIGN) {
      initializer = self.parseExpression()
    }

    self.match(TokenType.SEMICOLON)

    return { kind: "VarDecl", name: name, isConst: isConst, isMut: isMut || isVar, typeAnnotation: typeAnnotation, initializer: initializer, span: self.current().span }
  }

  fn parseFnDecl(self) -> AST.FnDecl {
    let isAsync = self.match(TokenType.ASYNC)
    self.consume(TokenType.FN, "Expected 'fn'")
    let name = self.consume(TokenType.IDENTIFIER, "Expected function name").value

    let generics = self.parseGenerics()

    self.consume(TokenType.LPAREN, "Expected '(' after function name")
    let params = self.parseParams()
    self.consume(TokenType.RPAREN, "Expected ')' after parameters")

    let returnType: AST.TypeExpr | nil = nil
    if self.match(TokenType.THIN_ARROW) {
      returnType = self.parseTypeExpression()
    }

    let body = self.parseBlock()

    return { kind: "FnDecl", name: name, isAsync: isAsync, isPub: false, generics: generics, params: params, returnType: returnType, body: body, span: self.current().span }
  }

  fn parseParams(self) -> [AST.Param] {
    let params: [AST.Param] = []
    if !self.check(TokenType.RPAREN) {
      repeat {
        let isRef = self.match(TokenType.REF)
        let isMut = self.match(TokenType.MUT)
        let name = self.consume(TokenType.IDENTIFIER, "Expected parameter name").value

        let pType: AST.TypeExpr | nil = nil
        if self.match(TokenType.COLON) {
          pType = self.parseTypeExpression()
        }

        let defaultValue: AST.Expression | nil = nil
        if self.match(TokenType.ASSIGN) {
          defaultValue = self.parseExpression()
        }

        params.push({ name: name, type: pType, defaultValue: defaultValue, isRef: isRef, isMut: isMut, span: self.current().span })
      } while self.match(TokenType.COMMA)
    }
    return params
  }

  fn parseGenerics(self) -> [AST.GenericParam] {
    if !self.match(TokenType.LT) {
      return []
    }
    let generics: [AST.GenericParam] = []
    repeat {
      let name = self.consume(TokenType.IDENTIFIER, "Expected generic parameter name").value
      let bounds: [AST.TypeExpr] = []
      if self.match(TokenType.COLON) {
        repeat {
          bounds.push(self.parseTypeExpression())
        } while self.match(TokenType.PLUS)
      }
      let defaultType: AST.TypeExpr | nil = nil
      if self.match(TokenType.ASSIGN) {
        defaultType = self.parseTypeExpression()
      }
      generics.push({ name: name, bounds: bounds, defaultType: defaultType, span: self.current().span })
    } while self.match(TokenType.COMMA)
    self.consume(TokenType.GT, "Expected '>' after generic parameters")
    return generics
  }

  fn parseBlock(self) -> AST.Block {
    self.consume(TokenType.LBRACE, "Expected '{' to start block")
    let statements: [AST.Statement] = []
    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      let stmt = self.parseStatement()
      if stmt != nil {
        statements.push(stmt)
      }
    }
    self.consume(TokenType.RBRACE, "Expected '}' to end block")
    return { kind: "Block", statements: statements, span: self.current().span }
  }

  fn parseIf(self) -> AST.IfStmt {
    let span = self.advance().span
    let condition = self.parseExpression()
    let thenBranch = self.parseBlock()
    let elseBranch: AST.Block | AST.IfStmt | nil = nil
    if self.match(TokenType.ELSE) {
      if self.check(TokenType.IF) {
        elseBranch = self.parseIf()
      } else {
        elseBranch = self.parseBlock()
      }
    }
    return { kind: "If", condition: condition, thenBranch: thenBranch, elseBranch: elseBranch, span: span }
  }

  fn parseWhile(self) -> AST.WhileStmt {
    let span = self.advance().span
    let condition = self.parseExpression()
    let body = self.parseBlock()
    return { kind: "While", condition: condition, body: body, span: span }
  }

  fn parseFor(self) -> AST.ForStmt | AST.ForInStmt {
    let span = self.advance().span

    if self.check(TokenType.LPAREN) || self.peek(1).type == TokenType.SEMICOLON {
      self.consume(TokenType.LPAREN, "Expected '('")
      let init: VarDecl | ExprStmt | nil = nil
      if !self.check(TokenType.SEMICOLON) {
        if self.check(TokenType.LET) || self.check(TokenType.CONST) {
          init = self.parseVarDecl()
        } else {
          init = self.parseExprStmt()
        }
      }
      self.consume(TokenType.SEMICOLON, "Expected ';'")
      let condition: Expression | nil = nil
      if !self.check(TokenType.SEMICOLON) {
        condition = self.parseExpression()
      }
      self.consume(TokenType.SEMICOLON, "Expected ';'")
      let increment: Expression | nil = nil
      if !self.check(TokenType.RPAREN) {
        increment = self.parseExpression()
      }
      self.consume(TokenType.RPAREN, "Expected ')'")
      let body = self.parseBlock()
      return { kind: "For", init: init, condition: condition, increment: increment, body: body, span: span }
    }

    let isConst = self.match(TokenType.CONST)
    let varName = self.consume(TokenType.IDENTIFIER, "Expected loop variable").value
    self.consume(TokenType.IN, "Expected 'in' in for-in loop")
    let iterable = self.parseExpression()
    let body = self.parseBlock()
    return { kind: "ForIn", varName: varName, isConst: isConst, iterable: iterable, body: body, span: span }
  }

  fn parseLoop(self) -> AST.WhileStmt {
    let span = self.advance().span
    let body = self.parseBlock()
    return { kind: "While", condition: { kind: "Literal", value: true, raw: "true", span: span }, body: body, span: span }
  }

  fn parseMatchStmt(self) -> AST.MatchStmt {
    let span = self.advance().span
    let expression = self.parseExpression()
    self.consume(TokenType.LBRACE, "Expected '{' after match expression")
    let arms: [AST.MatchArm] = []
    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      let pattern = self.parsePattern()
      let guard: Expression | nil = nil
      if self.match(TokenType.IF) {
        guard = self.parseExpression()
      }
      self.consume(TokenType.FAT_ARROW, "Expected '=>' after pattern")
      let body = self.check(TokenType.LBRACE) ? self.parseBlock() : self.parseExpression()
      arms.push({ pattern: pattern, guard: guard, body: body, span: self.current().span })
      self.match(TokenType.COMMA)
    }
    self.consume(TokenType.RBRACE, "Expected '}' after match arms")
    return { kind: "Match", expression: expression, arms: arms, span: span }
  }

  fn parseMatchExpression(self, span: Span) -> AST.MatchStmt {
    let expression = self.parseExpression()
    self.consume(TokenType.LBRACE, "Expected '{' after match expression")
    let arms: [AST.MatchArm] = []
    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      let pattern = self.parsePattern()
      self.consume(TokenType.FAT_ARROW, "Expected '=>' after pattern")
      let body = self.parseExpression()
      arms.push({ pattern: pattern, guard: nil, body: body, span: self.current().span })
      self.match(TokenType.COMMA)
    }
    self.consume(TokenType.RBRACE, "Expected '}' after match arms")
    return { kind: "Match", expression: expression, arms: arms, span: span }
  }

  fn parsePattern(self) -> AST.Pattern {
    if self.match(TokenType.UNDERSCORE) {
      return { kind: "WildcardPattern", span: self.current().span }
    }

    if self.check(TokenType.NUMBER) || self.check(TokenType.STRING) || self.check(TokenType.TRUE) || self.check(TokenType.FALSE) || self.check(TokenType.NIL) {
      let lit = self.parseExpression()
      return { kind: "LiteralPattern", value: lit as AST.Literal, span: lit.span }
    }

    if self.check(TokenType.IDENTIFIER) {
      let name = self.advance().value
      if self.check(TokenType.LPAREN) {
        self.advance()
        let fields: [AST.Pattern] = []
        if !self.check(TokenType.RPAREN) {
          repeat {
            fields.push(self.parsePattern())
          } while self.match(TokenType.COMMA)
        }
        self.consume(TokenType.RPAREN, "Expected ')'")
        return { kind: "EnumPattern", enumName: "", variant: name, fields: fields, span: self.current().span }
      }
      return { kind: "VariablePattern", name: name, span: self.current().span }
    }

    if self.match(TokenType.LBRACKET) {
      let elements: [AST.Pattern] = []
      let rest: AST.Pattern | nil = nil
      while !self.check(TokenType.RBRACKET) && !self.isAtEnd() {
        if self.match(TokenType.ELLIPSIS) {
          rest = self.parsePattern()
          break
        }
        elements.push(self.parsePattern())
        if !self.match(TokenType.COMMA) {
          break
        }
      }
      self.consume(TokenType.RBRACKET, "Expected ']'")
      return { kind: "ArrayPattern", elements: elements, rest: rest, span: self.current().span }
    }

    panic("Expected pattern")
  }

  fn parseReturn(self) -> AST.ReturnStmt {
    let span = self.advance().span
    let value: Expression | nil = nil
    if !self.check(TokenType.NEWLINE) && !self.check(TokenType.SEMICOLON) && !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      value = self.parseExpression()
    }
    self.match(TokenType.SEMICOLON)
    return { kind: "Return", value: value, span: span }
  }

  fn parseBreak(self) -> AST.BreakStmt {
    let span = self.advance().span
    let label: string | nil = nil
    if self.check(TokenType.IDENTIFIER) {
      label = self.advance().value
    }
    self.match(TokenType.SEMICOLON)
    return { kind: "Break", label: label, span: span }
  }

  fn parseContinue(self) -> AST.ContinueStmt {
    let span = self.advance().span
    let label: string | nil = nil
    if self.check(TokenType.IDENTIFIER) {
      label = self.advance().value
    }
    self.match(TokenType.SEMICOLON)
    return { kind: "Continue", label: label, span: span }
  }

  fn parseStruct(self) -> AST.StructDecl {
    let span = self.advance().span
    let name = self.consume(TokenType.IDENTIFIER, "Expected struct name").value
    let generics = self.parseGenerics()
    self.consume(TokenType.LBRACE, "Expected '{' after struct name")

    let fields: [AST.StructField] = []
    let methods: [AST.FnDecl] = []

    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      if self.check(TokenType.FN) {
        methods.push(self.parseFnDecl())
      } else {
        let isPub = self.match(TokenType.PUB)
        let fname = self.consume(TokenType.IDENTIFIER, "Expected field name").value
        self.consume(TokenType.COLON, "Expected ':' after field name")
        let ftype = self.parseTypeExpression()
        let defaultValue: Expression | nil = nil
        if self.match(TokenType.ASSIGN) {
          defaultValue = self.parseExpression()
        }
        fields.push({ name: fname, type: ftype, defaultValue: defaultValue, isPub: isPub, span: self.current().span })
        self.match(TokenType.COMMA)
      }
    }

    self.consume(TokenType.RBRACE, "Expected '}' after struct fields")
    return { kind: "StructDecl", name: name, isPub: false, generics: generics, fields: fields, methods: methods, span: span }
  }

  fn parseEnum(self) -> AST.EnumDecl {
    let span = self.advance().span
    let name = self.consume(TokenType.IDENTIFIER, "Expected enum name").value
    let generics = self.parseGenerics()
    self.consume(TokenType.LBRACE, "Expected '{' after enum name")

    let variants: [AST.EnumVariant] = []
    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      let vname = self.consume(TokenType.IDENTIFIER, "Expected variant name").value
      let fields: [AST.EnumField] = []
      let discriminant: number | nil = nil

      if self.match(TokenType.LPAREN) {
        repeat {
          let fname: string | nil = nil
          if self.check(TokenType.IDENTIFIER) && self.peek(1).type == TokenType.COLON {
            fname = self.advance().value
            self.advance()
          }
          let ftype = self.parseTypeExpression()
          fields.push({ name: fname, type: ftype, span: self.current().span })
        } while self.match(TokenType.COMMA)
        self.consume(TokenType.RPAREN, "Expected ')'")
      }

      if self.match(TokenType.ASSIGN) {
        discriminant = self.consume(TokenType.NUMBER, "Expected discriminant").value as number
      }

      variants.push({ name: vname, fields: fields, discriminant: discriminant, span: self.current().span })
      self.match(TokenType.COMMA)
    }

    self.consume(TokenType.RBRACE, "Expected '}' after enum variants")
    return { kind: "EnumDecl", name: name, isPub: false, generics: generics, variants: variants, span: span }
  }

  fn parseTrait(self) -> AST.TraitDecl {
    let span = self.advance().span
    let name = self.consume(TokenType.IDENTIFIER, "Expected trait name").value
    let generics = self.parseGenerics()
    self.consume(TokenType.LBRACE, "Expected '{' after trait name")

    let methods: [AST.FnSignature] = []
    let associatedTypes: [string] = []

    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      if self.match(TokenType.TYPE) {
        associatedTypes.push(self.consume(TokenType.IDENTIFIER, "Expected associated type name").value)
        self.match(TokenType.SEMICOLON)
      } else if self.check(TokenType.FN) {
        self.advance()
        let mname = self.consume(TokenType.IDENTIFIER, "Expected method name").value
        let mgenerics = self.parseGenerics()
        self.consume(TokenType.LPAREN, "Expected '('")
        let params = self.parseParams()
        self.consume(TokenType.RPAREN, "Expected ')'")
        let returnType: TypeExpr | nil = nil
        if self.match(TokenType.THIN_ARROW) {
          returnType = self.parseTypeExpression()
        }
        self.match(TokenType.SEMICOLON)
        methods.push({ name: mname, generics: mgenerics, params: params, returnType: returnType, span: self.current().span })
      }
    }

    self.consume(TokenType.RBRACE, "Expected '}' after trait body")
    return { kind: "TraitDecl", name: name, isPub: false, generics: generics, methods: methods, associatedTypes: associatedTypes, span: span }
  }

  fn parseImpl(self) -> AST.ImplDecl {
    let span = self.advance().span
    let generics = self.parseGenerics()
    let trait: TypeExpr | nil = nil
    let target = self.parseTypeExpression()

    if self.match(TokenType.FOR) {
      trait = target
      target = self.parseTypeExpression()
    }

    self.consume(TokenType.LBRACE, "Expected '{' after impl target")
    let methods: [AST.FnDecl] = []
    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      methods.push(self.parseFnDecl())
    }
    self.consume(TokenType.RBRACE, "Expected '}' after impl body")
    return { kind: "ImplDecl", target: target, trait: trait, generics: generics, methods: methods, span: span }
  }

  fn parseImport(self) -> AST.ImportDecl {
    let span = self.advance().span
    let path: string
    let items: [AST.ImportItem] | nil = nil
    let alias: string | nil = nil

    if self.check(TokenType.STRING) {
      path = self.advance().value
    } else {
      path = self.consume(TokenType.IDENTIFIER, "Expected import path").value
      while self.match(TokenType.DOT) {
        path = path + "." + self.consume(TokenType.IDENTIFIER, "Expected module name").value
      }
    }

    if self.match(TokenType.AS) {
      alias = self.consume(TokenType.IDENTIFIER, "Expected alias").value
    }

    if self.match(TokenType.LBRACE) {
      items = []
      repeat {
        let isType = self.match(TokenType.TYPE)
        let name = self.consume(TokenType.IDENTIFIER, "Expected import item").value
        let itemAlias: string | nil = nil
        if self.match(TokenType.AS) {
          itemAlias = self.consume(TokenType.IDENTIFIER, "Expected alias").value
        }
        items.push({ name: name, alias: itemAlias, isType: isType, span: self.current().span })
      } while self.match(TokenType.COMMA)
      self.consume(TokenType.RBRACE, "Expected '}' after import items")
    }

    self.match(TokenType.SEMICOLON)
    return { kind: "Import", path: path, items: items, alias: alias, span: span }
  }

  fn parseExport(self) -> AST.ExportDecl {
    let span = self.advance().span
    let declaration = self.parseStatement()
    return { kind: "Export", declaration: declaration, span: span }
  }

  fn parsePubStatement(self) -> AST.Statement {
    let stmt = self.parseStatement()
    if stmt.kind == "FnDecl" {
      return { kind: stmt.kind, name: stmt.name, isAsync: stmt.isAsync, isPub: true, generics: stmt.generics, params: stmt.params, returnType: stmt.returnType, body: stmt.body, span: stmt.span }
    }
    if stmt.kind == "StructDecl" {
      return { kind: stmt.kind, name: stmt.name, isPub: true, generics: stmt.generics, fields: stmt.fields, methods: stmt.methods, span: stmt.span }
    }
    if stmt.kind == "EnumDecl" {
      return { kind: stmt.kind, name: stmt.name, isPub: true, generics: stmt.generics, variants: stmt.variants, span: stmt.span }
    }
    if stmt.kind == "TraitDecl" {
      return { kind: stmt.kind, name: stmt.name, isPub: true, generics: stmt.generics, methods: stmt.methods, associatedTypes: stmt.associatedTypes, span: stmt.span }
    }
    return stmt
  }

  fn parseDefer(self) -> AST.DeferStmt {
    let span = self.advance().span
    let expression = self.parseExpression()
    self.match(TokenType.SEMICOLON)
    return { kind: "Defer", expression: expression, span: span }
  }

  fn parseGuard(self) -> AST.GuardStmt {
    let span = self.advance().span
    let condition = self.parseExpression()
    let elseBranch = self.parseBlock()
    return { kind: "Guard", condition: condition, elseBranch: elseBranch, span: span }
  }

  fn parseTypeAlias(self) -> AST.TypeAliasDecl {
    self.advance()
    let name = self.consume(TokenType.IDENTIFIER, "Expected type name").value
    let generics = self.parseGenerics()
    self.consume(TokenType.ASSIGN, "Expected '=' in type alias")
    let t = self.parseTypeExpression()
    self.match(TokenType.SEMICOLON)
    return { kind: "TypeAlias", name: name, generics: generics, type: t, span: self.current().span }
  }

  fn parseExprStmt(self) -> AST.ExprStmt {
    let expr = self.parseExpression()
    self.match(TokenType.SEMICOLON)
    return { kind: "ExprStmt", expression: expr, span: expr.span }
  }

  fn parseTableOrBlock(self) -> AST.Expression {
    if self.check(TokenType.IDENTIFIER) && self.peek(1).type == TokenType.COLON {
      return self.parseTableLiteral()
    }
    let block = self.parseBlock()
    return { kind: "BlockExpr", block: block, span: block.span }
  }

  fn parseTableLiteral(self) -> AST.TableExpr {
    let span = self.current().span
    self.consume(TokenType.LBRACE, "Expected '{'")
    let entries: [AST.TableEntry] = []

    while !self.check(TokenType.RBRACE) && !self.isAtEnd() {
      let key: Expression | string
      let isComputed = false

      if self.check(TokenType.IDENTIFIER) && self.peek(1).type == TokenType.COLON {
        key = self.advance().value
        self.advance()
      } else if self.match(TokenType.LBRACKET) {
        key = self.parseExpression()
        isComputed = true
        self.consume(TokenType.RBRACKET, "Expected ']' after computed key")
        self.consume(TokenType.COLON, "Expected ':' after key")
      } else {
        let name = self.consume(TokenType.IDENTIFIER, "Expected table key").value
        entries.push({ key: name, value: { kind: "Identifier", name: name, span: self.current().span }, isComputed: false, span: self.current().span })
        if !self.match(TokenType.COMMA) {
          break
        }
        continue
      }

      let value = self.parseExpression()
      entries.push({ key: key, value: value, isComputed: isComputed, span: self.current().span })
      if !self.match(TokenType.COMMA) {
        break
      }
    }

    self.consume(TokenType.RBRACE, "Expected '}' after table entries")
    return { kind: "Table", entries: entries, span: span }
  }

  fn parseLambda(self, span: Span) -> AST.LambdaExpr {
    self.consume(TokenType.LPAREN, "Expected '(' after 'fn'")
    let params = self.parseParams()
    self.consume(TokenType.RPAREN, "Expected ')' after parameters")

    let returnType: TypeExpr | nil = nil
    if self.match(TokenType.THIN_ARROW) {
      returnType = self.parseTypeExpression()
    }

    let body: Block | Expression
    if self.check(TokenType.LBRACE) {
      body = self.parseBlock()
    } else {
      self.consume(TokenType.FAT_ARROW, "Expected '=>' for lambda body")
      body = self.parseExpression()
    }

    return { kind: "Lambda", params: params, returnType: returnType, body: body, isAsync: false, span: span }
  }

  fn parseTernary(self, span: Span) -> AST.TernaryExpr {
    let condition = self.parseExpression()
    self.consume(TokenType.ELSE, "Expected 'else' in ternary")
    let thenExpr = self.parseExpression()
    self.consume(TokenType.ELSE, "Expected second 'else' in ternary")
    let elseExpr = self.parseExpression()
    return { kind: "Ternary", condition: condition, thenExpr: thenExpr, elseExpr: elseExpr, span: span }
  }

  fn parseTryExpression(self, span: Span) -> AST.TryExpr {
    let expression = self.parseExpression()
    let catchVar: string | nil = nil
    let catchBody: Block | nil = nil
    let finallyBody: Block | nil = nil

    if self.match(TokenType.CATCH) {
      if self.match(TokenType.LPAREN) {
        catchVar = self.consume(TokenType.IDENTIFIER, "Expected catch variable").value
        self.consume(TokenType.RPAREN, "Expected ')'")
      }
      catchBody = self.parseBlock()
    }

    if self.match(TokenType.FINALLY) {
      finallyBody = self.parseBlock()
    }

    return { kind: "Try", expression: expression, catchVar: catchVar, catchBody: catchBody, finallyBody: finallyBody, span: span }
  }

  fn parseTypeExpression(self) -> AST.TypeExpr {
    return self.parseUnionType()
  }

  fn parseUnionType(self) -> AST.TypeExpr {
    let left = self.parseIntersectionType()
    while self.match(TokenType.PIPE) {
      let right = self.parseIntersectionType()
      left = { kind: "UnionType", types: [left, right], span: self.current().span }
    }
    return left
  }

  fn parseIntersectionType(self) -> AST.TypeExpr {
    let left = self.parsePostfixType()
    while self.match(TokenType.AMPERSAND) {
      let right = self.parsePostfixType()
      left = { kind: "IntersectionType", types: [left, right], span: self.current().span }
    }
    return left
  }

  fn parsePostfixType(self) -> AST.TypeExpr {
    let t = self.parsePrimaryType()

    while true {
      if self.match(TokenType.QUESTION) {
        t = { kind: "OptionalType", inner: t, span: self.current().span }
      } else if self.match(TokenType.LBRACKET) {
        self.consume(TokenType.RBRACKET, "Expected ']'")
        t = { kind: "ArrayType", element: t, span: self.current().span }
      } else if self.match(TokenType.LT) {
        let args: [TypeExpr] = []
        repeat {
          args.push(self.parseTypeExpression())
        } while self.match(TokenType.COMMA)
        self.consume(TokenType.GT, "Expected '>'")
        t = { kind: "GenericType", name: (t as AST.NamedType).name, args: args, span: self.current().span }
      } else {
        break
      }
    }

    return t
  }

  fn parsePrimaryType(self) -> AST.TypeExpr {
    if self.match(TokenType.REF) {
      return { kind: "RefType", inner: self.parsePrimaryType(), span: self.current().span }
    }

    if self.match(TokenType.MUT) {
      return { kind: "MutType", inner: self.parsePrimaryType(), span: self.current().span }
    }

    if self.match(TokenType.SELF) {
      return { kind: "SelfType", span: self.current().span }
    }

    if self.match(TokenType.LPAREN) {
      let types: [TypeExpr] = []
      if !self.check(TokenType.RPAREN) {
        repeat {
          types.push(self.parseTypeExpression())
        } while self.match(TokenType.COMMA)
      }
      self.consume(TokenType.RPAREN, "Expected ')'")

      if self.match(TokenType.THIN_ARROW) {
        let returnType = self.parseTypeExpression()
        return { kind: "FunctionType", params: types, returnType: returnType, span: self.current().span }
      }

      return { kind: "TupleType", elements: types, span: self.current().span }
    }

    if self.check(TokenType.IDENTIFIER) {
      let name = self.advance().value
      return { kind: "NamedType", name: name, span: self.current().span }
    }

    panic("Expected type expression")
  }

  fn getPrecedence(self) -> number {
    match self.current().type {
      TokenType.ASSIGN => return 10
      TokenType.PLUS_EQ => return 10
      TokenType.MINUS_EQ => return 10
      TokenType.STAR_EQ => return 10
      TokenType.SLASH_EQ => return 10
      TokenType.AS => return 15
      TokenType.OR => return 20
      TokenType.NULL_COALESCE => return 25
      TokenType.AND => return 30
      TokenType.EQ => return 40
      TokenType.NEQ => return 40
      TokenType.LT => return 40
      TokenType.LE => return 40
      TokenType.GT => return 40
      TokenType.GE => return 40
      TokenType.IS => return 40
      TokenType.AMPERSAND => return 45
      TokenType.PIPE => return 35
      TokenType.PLUS => return 50
      TokenType.MINUS => return 50
      TokenType.RANGE => return 55
      TokenType.RANGE_INCLUSIVE => return 55
      TokenType.STAR => return 60
      TokenType.SLASH => return 60
      TokenType.PERCENT => return 60
      TokenType.CARET => return 70
      TokenType.DOT => return 80
      TokenType.OPTIONAL_CHAIN => return 80
      TokenType.LPAREN => return 80
      TokenType.LBRACKET => return 80
      _ => return 0
    }
  }

  fn current(self) -> Token {
    return self.tokens[self.pos]
  }

  fn advance(self) -> Token {
    let t = self.tokens[self.pos]
    self.pos = self.pos + 1
    return t
  }

  fn peek(self, offset: number) -> Token {
    let idx = self.pos + offset
    if idx < self.tokens.length {
      return self.tokens[idx]
    }
    return self.tokens[self.tokens.length - 1]
  }

  fn match(self, type: TokenType) -> bool {
    if self.check(type) {
      self.pos = self.pos + 1
      return true
    }
    return false
  }

  fn check(self, type: TokenType) -> bool {
    return self.current().type == type
  }

  fn isAtEnd(self) -> bool {
    return self.current().type == TokenType.EOF
  }

  fn consume(self, type: TokenType, message: string) -> Token {
    if self.check(type) {
      return self.advance()
    }
    panic(message + ", got " + self.current().value)
  }
}

pub fn parse(source: string, fileName: string) -> AST.Program {
  let tokens = tokenize(source, fileName)
  return Parser.new(tokens).parse()
}
