# Luazi Git Attributes
# Tells Git/GitHub how to handle .lz files and other project files

# ============================================================================
# LANGUAGE DETECTION
# ============================================================================

# Register .lz as Luazi language (for GitHub linguist bar)
*.lz linguist-language=Luazi
*.lz linguist-detectable=true

# Standard library files
*.lz text eol=lf

# ============================================================================
# SOURCE FILES
# ============================================================================

# TypeScript
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf

# JavaScript
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# C++
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.cxx text eol=lf

# C#
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# WebAssembly Text
*.wat text eol=lf
*.wast text eol=lf

# ============================================================================
# CONFIG FILES
# ============================================================================

*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf

# ============================================================================
# MARKUP / DOCS
# ============================================================================

*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# ============================================================================
# BUILD / SCRIPTS
# ============================================================================

*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
Makefile text eol=lf
makefile text eol=lf
*.mk text eol=lf
CMakeLists.txt text eol=lf

# Windows scripts (keep CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ============================================================================
# BINARY FILES (don't diff, don't merge text)
# ============================================================================

# Compiled output
*.wasm binary
*.lzc binary
*.o binary
*.obj binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary

# .NET
*.dll binary
*.pdb binary
*.nuget binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# ============================================================================
# DIFF BEHAVIOR
# ============================================================================

# Use built-in diff for these
*.lz diff
*.ts diff
*.js diff
*.cpp diff
*.cs diff
*.md diff

# ============================================================================
# MERGE BEHAVIOR
# ============================================================================

# Lock files - always take theirs on conflict
package-lock.json merge=ours
yarn.lock merge=ours
pnpm-lock.yaml merge=ours

# ============================================================================
# EXPORT IGNORE (for npm package / git archive)
# ============================================================================

# Tests
examples/ export-ignore
benchmarks/ export-ignore
tests/ export-ignore
__tests__/ export-ignore

# Dev configs
.gitattributes export-ignore
.gitignore export-ignore
.vscode/ export-ignore
.idea/ export-ignore

# CI
.github/ export-ignore
.travis.yml export-ignore
.appveyor.yml export-ignore

# Docs (keep README/LICENSE)
docs/ export-ignore
*.md export-ignore
!README.md export-ignore
!LICENSE export-ignore

# Build artifacts
dist/ export-ignore
build/ export-ignore
out/ export-ignore
bin/ export-ignore
obj/ export-ignore
node_modules/ export-ignore
coverage/ export-ignore
.nyc_output/ export-ignore
