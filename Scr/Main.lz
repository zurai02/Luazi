// main.lz - Luazi Self-Hosted Compiler CLI
// Entry point for the self-hosted toolchain

import core
import compiler

fn print_usage() {
  println("Luazi Self-Hosted Compiler")
  println("")
  println("Usage: luazi <command> [options] <file>")
  println("")
  println("Commands:")
  println("  run      <file>     Run a Luazi source file")
  println("  compile  <file>     Compile to bytecode")
  println("  check    <file>     Type-check only")
  println("  parse    <file>     Parse and print AST")
  println("  tokenize <file>     Tokenize and print tokens")
  println("  fmt      <file>     Format source code")
  println("  repl                Start interactive REPL")
  println("  version             Print version")
}

fn cmd_run(args: Vec<string>) {
  if args.len() < 1 { println("Error: No file specified"); return }
  let path = args[0]
  let source = fs.read_file(path)
  let result = compiler.compile(source, path)
  if !result.success {
    for err in result.errors { println("Error: " + err) }
    return
  }
  let value = vm.run(result.module)
  println(value.to_string())
}

fn cmd_compile(args: Vec<string>) {
  if args.len() < 1 { println("Error: No file specified"); return }
  let path = args[0]
  let source = fs.read_file(path)
  let result = compiler.compile(source, path)
  if !result.success {
    for err in result.errors { println("Error: " + err) }
    return
  }
  let bytecode = serialize(result.module)
  fs.write_file(path + ".lzbc", bytecode)
  println("Compiled to " + path + ".lzbc")
}

fn cmd_check(args: Vec<string>) {
  if args.len() < 1 { println("Error: No file specified"); return }
  let path = args[0]
  let source = fs.read_file(path)
  let result = compiler.compile(source, path)
  if result.success { println("No type errors found.") }
  else { for err in result.errors { println("Error: " + err) } }
}

fn cmd_parse(args: Vec<string>) {
  if args.len() < 1 { println("Error: No file specified"); return }
  let path = args[0]
  let source = fs.read_file(path)
  let program = parser.parse(source, path)
  println(ast_to_string(program))
}

fn cmd_tokenize(args: Vec<string>) {
  if args.len() < 1 { println("Error: No file specified"); return }
  let path = args[0]
  let source = fs.read_file(path)
  let tokens = tokenizer.tokenize(source, path)
  for tok in tokens { println(tok.type + " '" + tok.lexeme + "' @ " + tok.line + ":" + tok.col) }
}

fn cmd_fmt(args: Vec<string>) {
  if args.len() < 1 { println("Error: No file specified"); return }
  let path = args[0]
  let source = fs.read_file(path)
  let program = parser.parse(source, path)
  let formatted = format_ast(program)
  fs.write_file(path, formatted)
  println("Formatted " + path)
}

fn cmd_repl() {
  println("Luazi REPL (self-hosted)")
  println("Type 'exit' to quit")
  let mut line_num = 1
  while true {
    print("luazi> ")
    let line = io.read_line()
    if line == "exit" { break }
    let result = compiler.run_source(line, "<repl>")
    println(result.to_string())
    line_num = line_num + 1
  }
}

fn cmd_version() {
  println("Luazi 0.2.0 (self-hosted)")
  println("Compiler written in Luazi")
}

fn main(args: Vec<string>) -> int {
  if args.len() < 1 { print_usage(); return 1 }
  let command = args[0]
  let cmd_args = args.slice(1, args.len())

  match command {
    "run" => cmd_run(cmd_args),
    "compile" => cmd_compile(cmd_args),
    "check" => cmd_check(cmd_args),
    "parse" => cmd_parse(cmd_args),
    "tokenize" => cmd_tokenize(cmd_args),
    "fmt" => cmd_fmt(cmd_args),
    "repl" => cmd_repl(),
    "version" => cmd_version(),
    _ => { println("Unknown command: " + command); print_usage(); return 1 }
  }
  return 0
}
