				if o.Flag then Celestial.Flags[o.Flag]=o saveConfig() end
			end
			return o
		end

		return Tab
	end -- _createTab

	function Win:CreateTab(name, icon, ext)
		local tabOpts
		if type(name)=="table" then tabOpts=name
		else tabOpts={Name=name, Icon=icon} end
		return self:_createTab(tabOpts, ext and tabScroll or nil)
	end

	-- Entrance animation (after key system)
	local function showWindow()
		win.Size=UDim2.new(0,0,0,0) win.Position=UDim2.new(0.5,0,0.5,0) win.BackgroundTransparency=1
		task.wait()
		tf(win, TSP, {Size=UDim2.new(0,W,0,H), Position=UDim2.new(0.5,-W/2,0.5,-H/2), BackgroundTransparency=T.WindowTrans})
	end

	-- Key system then show
	if opts.KeySystem then
		task.spawn(function()
			task.wait(1.6) finishLoading()
			runKeySystem(opts, T, function(passed)
				if passed then
					showWindow()
				else
					Celestial:Destroy()
				end
			end)
		end)
	else
		task.spawn(function()
			task.wait(1.6)
			finishLoading()
			showWindow()
		end)
	end

	self.ActiveTheme = T
	self._winObj = Win
	table.insert(self.Windows, Win)
	return Win
end -- CreateWindow

return Celestial
