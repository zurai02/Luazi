local _nScreen, _nHolder
local function ensureNotif()
	if _nHolder and _nHolder.Parent then return end
	_nScreen = mk("ScreenGui", {Name="CelestialNotifs", ResetOnSpawn=false, IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, DisplayOrder=900})
	local ok = pcall(function() _nScreen.Parent = CoreGui end)
	if not ok then pcall(function() _nScreen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end) end
	_nHolder = mk("Frame", {Name="Holder", Size=UDim2.new(0,310,1,-20), Position=UDim2.new(1,-326,0,10), BackgroundTransparency=1}, _nScreen)
	local nl = ll(Enum.FillDirection.Vertical, Enum.SortOrder.LayoutOrder, 10, _nHolder)
	nl.VerticalAlignment = Enum.VerticalAlignment.Bottom
end

