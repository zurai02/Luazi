------------------------------------------------------------------------
-- PACK / UNPACK COLOR (Rayfield config compatibility)
------------------------------------------------------------------------
local function packColor(c) return {R=c.R*255, G=c.G*255, B=c.B*255} end
local function unpackColor(c) return Color3.fromRGB(c.R, c.G, c.B) end

------------------------------------------------------------------------
-- SAVE CONFIG
------------------------------------------------------------------------
local _cfgEnabled = false
local _globalLoaded = false
local function saveConfig()
	if not _cfgEnabled or not _globalLoaded or not _activeCfgFile then return end
	local data = {}
	for flag, elem in pairs(Celestial.Flags) do
		if elem.Type == "ColorPicker" then
			data[flag] = packColor(elem.Color)
		else
			local v = elem.CurrentValue
			if typeof(v) == "boolean" then
				data[flag] = v
			else
				data[flag] = v or elem.CurrentKeybind or elem.CurrentOption or elem.Color
			end
		end
	end
	safe(writefile, _activeCfgFile, HTTP:JSONEncode(data))
end

------------------------------------------------------------------------
-- LOAD CONFIG (called at end of script, Rayfield-compatible)
------------------------------------------------------------------------
function Celestial:LoadConfiguration()
	if not _cfgEnabled or not _activeCfgFile then _globalLoaded = true return end
	if not safe(isfile, _activeCfgFile) then _globalLoaded = true return end
	local raw = safe(readfile, _activeCfgFile)
	if not raw then _globalLoaded = true return end
	local ok, data = pcall(function() return HTTP:JSONDecode(raw) end)
	if not ok then _globalLoaded = true return end
	local changed = false
	for flagName, flag in pairs(Celestial.Flags) do
		local val = data[flagName]
		if val ~= nil then
			changed = true
			task.spawn(function()
				if flag.Type == "ColorPicker" then
					flag:Set(unpackColor(val))
				else
					flag:Set(val)
				end
			end)
		end
	end
	if changed then
		self:Notify({Title="Celestial Configurations", Content="Your saved configuration has been loaded.", Duration=3})
	end
	_globalLoaded = true
end

-- Rayfield-style: called without colon
function Celestial.LoadConfiguration(...)
	return Celestial:LoadConfiguration(...)
end

------------------------------------------------------------------------
-- NOTIFY
------------------------------------------------------------------------
function Celestial:Notify(opts)
	opts = opts or {}
	ensureNotif()
	if not _nHolder then
		print("[Celestial] ".. (opts.Title or "") ..": ".. (opts.Content or ""))
		return
	end
	local existing = {}
	for _, c in ipairs(_nHolder:GetChildren()) do
		if c:IsA("Frame") then table.insert(existing, c) end
	end
	if #existing >= 5 then existing[1]:Destroy() end
	playSound(SND_NOTIFY)

	local T = opts.Theme and Themes[opts.Theme] or Themes.Celestial
	local dur = opts.Duration or 4
	local nt = opts.Type or "info"
	local acMap = {info=T.Accent, success=rgb(58,214,130), warn=rgb(255,178,40), error=rgb(255,82,82)}
	local ac = acMap[nt] or T.Accent
	local iconMap = {info="i", success="✓", warn="!", error="✕"}

	local card = mk("Frame", {Size=UDim2.new(1,0,0,72), BackgroundColor3=T.WindowBg, BackgroundTransparency=1}, _nHolder)
