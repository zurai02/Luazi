local function gs(n)
	local s = game:GetService(n)
	return if cloneref then cloneref(s) else s
end
local UIS     = gs("UserInputService")
local TS      = gs("TweenService")
local Players = gs("Players")
local CoreGui = gs("CoreGui")
local HTTP    = gs("HttpService")
local Run     = gs("RunService")
local TXS     = gs("TextService")
local SndSvc  = gs("SoundService")

------------------------------------------------------------------------
-- SAFE HELPERS
------------------------------------------------------------------------
local function safe(fn, ...)
	if type(fn) ~= "function" then return nil end
	local ok, r = pcall(fn, ...) if not ok then warn("[Celestial] "..tostring(r)) end
	return ok and r or nil
end
local function folder(p)
	if isfolder and not safe(isfolder, p) then safe(makefolder, p) end
end
local function tf(inst, info, goals)
	local t = TS:Create(inst, info, goals) t:Play() return t
end

local TF  = TweenInfo.new(0.12, Enum.EasingStyle.Quint,  Enum.EasingDirection.Out)
local TM  = TweenInfo.new(0.22, Enum.EasingStyle.Quint,  Enum.EasingDirection.Out)
local TS2 = TweenInfo.new(0.38, Enum.EasingStyle.Quint,  Enum.EasingDirection.Out)
local TSP = TweenInfo.new(0.45, Enum.EasingStyle.Back,   Enum.EasingDirection.Out)
local TSO = TweenInfo.new(0.50, Enum.EasingStyle.Quart,  Enum.EasingDirection.Out)
local TEX = TweenInfo.new(0.60, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

local function mk(cls, p, par)
	local i = Instance.new(cls)
	for k, v in pairs(p or {}) do pcall(function() (i::any)[k] = v end) end
	if par then i.Parent = par end
	return i
end
local function cor(r, p) return mk("UICorner", {CornerRadius=UDim.new(0,r)}, p) end
local function str(c, th, tr, p)
	return mk("UIStroke", {Color=c, Thickness=th or 1, Transparency=tr or 0, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, p)
end
local function ll(dir, sort, sp, p)
	return mk("UIListLayout", {FillDirection=dir or Enum.FillDirection.Vertical, SortOrder=sort or Enum.SortOrder.LayoutOrder, Padding=UDim.new(0,sp or 6)}, p)
end
local function pd(l,r,t,b,p)
	return mk("UIPadding", {PaddingLeft=UDim.new(0,l or 0), PaddingRight=UDim.new(0,r or 0), PaddingTop=UDim.new(0,t or 0), PaddingBottom=UDim.new(0,b or 0)}, p)
end
local function grad(rot, kp, tp, p)
	return mk("UIGradient", {Rotation=rot or 0, Color=kp, Transparency=tp or NumberSequence.new(0)}, p)
end

