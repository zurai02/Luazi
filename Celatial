------------------------------------------------------------------------
local function runKeySystem(opts, T, cb)
	local ks = opts.KeySettings
	if not ks then cb(true) return end

	folder(FOLDER) folder(KEY_DIR)
	local keys = type(ks.Key) == "string" and {ks.Key} or (ks.Key or {"Key"})
	local fileName = ks.FileName or "Key"

	-- Fetch keys from URLs if needed
	if ks.GrabKeyFromSite then
		for i, k in ipairs(keys) do
			local ok, res = pcall(function() return game:HttpGet(k):gsub("[\n\r ]", "") end)
			if ok then keys[i] = res end
		end
	end

	-- Check saved key
	local keyFile = KEY_DIR.."/"..fileName..EXT
	if safe(isfile, keyFile) then
		local saved = safe(readfile, keyFile)
		for _, k in ipairs(keys) do
			if saved and saved:find(k, 1, true) then cb(true) return end
		end
	end

	-- Show key UI
	local attempts = ks.MaxAttempts or 5
	local screen = mk("ScreenGui", {Name="CelestialKey", ResetOnSpawn=false, IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Sibling, DisplayOrder=999})
	pcall(function() screen.Parent = CoreGui end)

	local dim = mk("Frame", {Size=UDim2.new(1,0,1,0), BackgroundColor3=rgb(0,0,0), BackgroundTransparency=0.4}, screen)
	local box = mk("Frame", {Size=UDim2.new(0,0,0,0), AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0.5,0,0.5,0), BackgroundColor3=T.WindowBg, BackgroundTransparency=0.03, ZIndex=10}, screen)
	cor(16, box) str(T.StrokeLight, 1, T.StrokeLightTrans, box)
	grad(120, ColorSequence.new({ColorSequenceKeypoint.new(0,T.WindowBg2), ColorSequenceKeypoint.new(0.5,T.WindowBg), ColorSequenceKeypoint.new(1,T.WindowBg2)}), NumberSequence.new(0), box)

	local function addLabel(text, y, size, font, color)
		return mk("TextLabel", {Position=UDim2.new(0,24,0,y), Size=UDim2.new(1,-48,0,size), BackgroundTransparency=1, Text=text, TextColor3=color or T.TextPrimary, Font=font or Enum.Font.Gotham, TextSize=size, TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, ZIndex=11}, box)
	end

	addLabel(ks.Title or opts.Name or "Celestial", 20, 18, Enum.Font.GothamBold)
	addLabel(ks.Subtitle or "Key System", 44, 13, Enum.Font.Gotham, T.TextSecondary)
	local noteLabel = addLabel(ks.Note or "Enter your key below.", 66, 12, Enum.Font.Gotham, T.TextMuted)
	noteLabel.Size = UDim2.new(1,-48,0,32) noteLabel.TextWrapped = true

	local inputBg = mk("Frame", {Position=UDim2.new(0,24,0,104), Size=UDim2.new(1,-48,0,36), BackgroundColor3=T.InputBackground, BackgroundTransparency=0.05, ZIndex=11}, box)
	cor(9, inputBg) str(T.InputStroke, 1, 0.4, inputBg)
	local inputBox = mk("TextBox", {Size=UDim2.new(1,-18,1,0), Position=UDim2.new(0,9,0,0), BackgroundTransparency=1, PlaceholderText="Enter key...", PlaceholderColor3=T.PlaceholderColor, TextColor3=T.TextPrimary, Font=Enum.Font.Gotham, TextSize=13, ClearTextOnFocus=false, ZIndex=12}, inputBg)

	local attLbl = mk("TextLabel", {Position=UDim2.new(0,24,0,146), Size=UDim2.new(1,-48,0,14), BackgroundTransparency=1, Text="", TextColor3=T.TextMuted, Font=Enum.Font.Gotham, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=11}, box)
	local confirmBtn = mk("TextButton", {Position=UDim2.new(0,24,0,168), Size=UDim2.new(1,-48,0,36), BackgroundColor3=T.Accent, Text="Confirm", TextColor3=T.AccentText, Font=Enum.Font.GothamBold, TextSize=13, AutoButtonColor=false, ZIndex=11}, box)
	cor(9, confirmBtn)

	local hideBtn = mk("TextButton", {Position=UDim2.new(1,-44,0,8), Size=UDim2.new(0,32,0,28), BackgroundTransparency=1, Text="×", TextColor3=T.TextMuted, Font=Enum.Font.GothamBold, TextSize=18, AutoButtonColor=false, ZIndex=12}, box)
	hideBtn.MouseButton1Click:Connect(function()
		tf(box, TM, {BackgroundTransparency=1}) tf(dim, TM, {BackgroundTransparency=1})
		task.delay(0.25, function() screen:Destroy() end)
		cb(false)
	end)

	tf(box, TSP, {Size=UDim2.new(0,420,0,215)})

	local function tryKey()
		local txt = inputBox.Text
		if #txt == 0 then return end
		for _, k in ipairs(keys) do
			if txt == k then
				if ks.SaveKey then safe(writefile, keyFile, k) end
				tf(box, TM, {BackgroundTransparency=1}) tf(dim, TM, {BackgroundTransparency=1})
				task.delay(0.25, function() screen:Destroy() end)
				cb(true)
				return
			end
		end
		attempts -= 1
		if attempts <= 0 then
			Players.LocalPlayer:Kick("No key attempts remaining.")
			return
		end
		attLbl.Text = "Incorrect key. "..attempts.." attempt(s) remaining."
		inputBox.Text = ""
		-- shake animation
		tf(box, TweenInfo.new(0.05, Enum.EasingStyle.Quad), {Position=UDim2.new(0.5,-12,0.5,0)})
		task.wait(0.07) tf(box, TweenInfo.new(0.05, Enum.EasingStyle.Quad), {Position=UDim2.new(0.5,12,0.5,0)})
		task.wait(0.07) tf(box, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Position=UDim2.new(0.5,0,0.5,0)})
	end

	confirmBtn.MouseButton1Click:Connect(tryKey)
	inputBox.FocusLost:Connect(function(enter) if enter then tryKey() end end)
end

------------------------------------------------------------------------
-- SET THEME  /  REGISTER THEME
------------------------------------------------------------------------
function Celestial:SetTheme(name)
	local T = Themes[name] if not T then warn("[Celestial] Unknown theme: "..tostring(name)) return end
	self.ActiveTheme = T
	for _, win in ipairs(self.Windows or {}) do
		win._theme = T
		for _, cb in ipairs(win._themeCallbacks or {}) do safe(cb, T) end
	end
end
function Celestial:RegisterTheme(name, t)
	local base = Themes.Celestial merged = {}
	for k,v in pairs(base) do merged[k]=v end
	for k,v in pairs(t) do merged[k]=v end
	Themes[name] = merged return merged
end
function Celestial:IsVisible() return not _hidden end
function Celestial:SetVisibility(v) if self._winObj then if v then self._winObj:_show() else self._winObj:_hide() end end end
function Celestial:Destroy()
	_destroyed = true
	for _, c in ipairs(_keybindConns) do pcall(function() c:Disconnect() end) end
	for _, win in ipairs(self.Windows or {}) do
		if win._maid then win._maid:clean() end
		if win._screen then pcall(function() win._screen:Destroy() end) end
	end
	self.Windows = {}
end

Celestial.Windows = {}
Celestial.ActiveTheme = Themes.Celestial

------------------------------------------------------------------------
-- MAID
------------------------------------------------------------------------
local function newMaid()
	local m = {_t={}}
	function m:add(j) if j then table.insert(self._t, j) end return j end
	function m:clean()
		for _, j in ipairs(self._t) do
			if typeof(j)=="RBXScriptConnection" then j:Disconnect()
			elseif typeof(j)=="Instance" then pcall(function() j:Destroy() end)
			elseif type(j)=="function" then pcall(j) end
		end
		for i=#self._t,1,-1 do self._t[i]=nil end
	end
	return m
end

------------------------------------------------------------------------
-- POINT-IN-RECT
------------------------------------------------------------------------
local function inside(pos, inst)
	if not inst or not inst.Parent then return false end
	local ap, as = inst.AbsolutePosition, inst.AbsoluteSize
	return pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y
end

