			local ts = str(state and theme.ToggleEnabledStroke or theme.ToggleDisabledStroke, 1.5, 0.3, knob)
			local clickArea = mk("TextButton", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text=""}, row)

			local function setState(val, skipCallback)
				state=val val=val==true
				playSound(SND_TOGGLE)
				tf(track, TM, {BackgroundColor3=val and theme.ToggleEnabled or theme.ToggleDisabled})
				tf(knob, TSP, {Position=val and UDim2.new(1,-23,0.5,-10) or UDim2.new(0,3,0.5,-10), Size=UDim2.new(0,20,0,20)})
