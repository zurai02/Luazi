import { Span, StringBuilder, is_digit, is_alpha, is_alphanumeric } from "src/core/core"

import { getStdLib, FsModule, PathModule, CryptoModule, ProcessModule } from "src/stdlib/index"
import { getFs } from "src/stdlib/fs"
import { getPath } from "src/stdlib/path"
import { getCrypto } from "src/stdlib/crypto"
import { getProcess } from "src/stdlib/process"

