  Vec2, Vec3, Vec4, Mat4,
  PI, TAU, E, PHI, EPSILON, INF, NAN,
  abs, floor, ceil, round, trunc, min, max, clamp, lerp, inv_lerp, remap,
  sign, sqrt, cbrt, pow, exp, log, ln, log10, log2,
  sin, cos, tan, asin, acos, atan, atan2, sinh, cosh, tanh, deg, rad,
